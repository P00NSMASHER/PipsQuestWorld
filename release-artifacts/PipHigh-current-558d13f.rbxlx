        boundary.name,
        boundary.size,
        CFrame.new(gym.X + boundary.x, 1.02, gym.Z + boundary.z),
        Color3.fromRGB(245, 245, 245),
        Enum.Material.SmoothPlastic
    )
    stripe.CanCollide = false
end

for row = 0, 2 do
