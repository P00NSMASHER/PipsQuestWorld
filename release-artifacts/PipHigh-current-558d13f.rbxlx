      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">HousingLifecycle</string>
          <string name="Source"><![CDATA[--!strict
-- Pure active-session housing plot authority.
-- Durable ownership/money remains in EconomyRepository.

local HousingLifecycle = {}
HousingLifecycle.__index = HousingLifecycle

local function validKey(value)
    return type(value) == "string" and value ~= ""
end

local function copy(state)
    if state == nil then return nil end
    return {
        playerKey = state.playerKey,
        plotId = state.plotId,
        editing = state.editing == true,
        styleId = state.styleId,
    }
end

function HousingLifecycle.new(plotIds)
    assert(type(plotIds) == "table" and #plotIds > 0, "plotIds are required")
    local seen = {}
    local ordered = {}
    for index, plotId in ipairs(plotIds) do
        assert(validKey(plotId), "plot id must be a non-empty string")
        assert(not seen[plotId], "duplicate plot id")
        seen[plotId] = true
        ordered[index] = plotId
    end

    return setmetatable({
        _plots = ordered,
        _ownerByPlot = {},
        _stateByPlayer = {},
    }, HousingLifecycle)
end

function HousingLifecycle:get(playerKey)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    return copy(self._stateByPlayer[playerKey])
end

function HousingLifecycle:claim(playerKey)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    local existing = self._stateByPlayer[playerKey]
    if existing then
        return {
            accepted = true,
            code = "plot_already_claimed",
            state = copy(existing),
        }
    end

    for _, plotId in ipairs(self._plots) do
        if self._ownerByPlot[plotId] == nil then
            local state = {
                playerKey = playerKey,
                plotId = plotId,
                editing = false,
                styleId = "classic-blue",
            }
            self._ownerByPlot[plotId] = playerKey
            self._stateByPlayer[playerKey] = state
            return {
                accepted = true,
                code = "plot_claimed",
                state = copy(state),
            }
        end
    end

    return {
        accepted = false,
        code = "no_plot_available",
        state = nil,
    }
end

function HousingLifecycle:release(playerKey)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    local current = self._stateByPlayer[playerKey]
    if current == nil then
        return { accepted = true, code = "plot_already_released" }
    end

    self._ownerByPlot[current.plotId] = nil
    self._stateByPlayer[playerKey] = nil
    return {
        accepted = true,
        code = "plot_released",
        released = copy(current),
    }
end

function HousingLifecycle:isOwner(playerKey, plotId)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    assert(validKey(plotId), "plotId must be a non-empty string")
    return self._ownerByPlot[plotId] == playerKey
end

function HousingLifecycle:setEditing(playerKey, enabled)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    local current = self._stateByPlayer[playerKey]
    if current == nil then
        return { accepted = false, code = "no_active_plot" }
    end
    current.editing = enabled == true
    return {
        accepted = true,
        code = current.editing and "edit_started" or "edit_ended",
        state = copy(current),
    }
end

function HousingLifecycle:setStyle(playerKey, styleId)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    local current = self._stateByPlayer[playerKey]
    if current == nil then
        return { accepted = false, code = "no_active_plot" }
    end
    if current.editing ~= true then
        return { accepted = false, code = "edit_mode_required", state = copy(current) }
    end
    if not validKey(styleId) then
        return { accepted = false, code = "invalid_style", state = copy(current) }
    end
    current.styleId = styleId
    return {
        accepted = true,
        code = "style_changed",
        state = copy(current),
    }
end

return HousingLifecycle
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="26">
        <Properties>
          <string name="Name">HousingService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Legacy housing/property adapter.
-- Free Roam owns active housing interactions; EconomyRepository remains the
-- single durable money/ownership authority and Foundation owns plot geometry.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local SchoolConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SchoolConfig"))
local schoolFoundation = ServerScriptService:WaitForChild("SchoolFoundation")
local EconomyRuntime = require(schoolFoundation:WaitForChild("EconomyRuntime"))
local HousingLifecycle = require(schoolFoundation:WaitForChild("HousingLifecycle"))
local HousingLayoutRepository = require(schoolFoundation:WaitForChild("HousingLayoutRepository"))
local HousingEditorController = require(schoolFoundation:WaitForChild("HousingEditorController"))
local VersionedDataStore = require(schoolFoundation:WaitForChild("ProgressionDataStore"))

local HOUSE_PRICE = 50
local HOUSE_UNLOCK = { category = "house", itemId = "starter-house" }
local STYLE_COLORS = {
    ["classic-blue"] = Color3.fromRGB(176, 190, 199),
    ["classic-tan"] = Color3.fromRGB(191, 177, 155),
    ["classic-red"] = Color3.fromRGB(183, 127, 119),
    ["classic-green"] = Color3.fromRGB(145, 171, 132),
}

local function createHousingLayoutStore()
    if RunService:IsStudio() and game.GameId == 0 then
        local StudioStore = require(schoolFoundation:WaitForChild("ProgressionStudioStore"))
        Workspace:SetAttribute("HousingLayoutPersistenceMode", "StudioMemoryUnpublished")
        return StudioStore.shared("housing-layout")
    end

    Workspace:SetAttribute("HousingLayoutPersistenceMode", "DataStore")
    return VersionedDataStore.new(
        DataStoreService:GetDataStore("PipHighHousingLayoutV1")
    )
end

local housingLayoutStore = createHousingLayoutStore()
local layoutRepositoryByPlayerId = {}

local plotIds = {}
local plotConfigById = {}
for index, plot in ipairs(SchoolConfig.HousingPlots) do
    plotIds[index] = plot.id
    plotConfigById[plot.id] = plot
end
local lifecycle = HousingLifecycle.new(plotIds)

local campus = Workspace:WaitForChild("SchoolCampus")
local housingPlotsFolder = campus:WaitForChild("HousingPlots")

local function getOrCreateFolder(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("Folder"), name .. " must be a Folder")
        return existing
    end
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent
    return folder
end

local function getOrCreateRemoteFunction(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("RemoteFunction"), name .. " must be a RemoteFunction")
        return existing
    end
    local remote = Instance.new("RemoteFunction")
    remote.Name = name
    remote.Parent = parent
    return remote
end

local remoteRoot = ReplicatedStorage:WaitForChild(SchoolConfig.Interfaces.remoteFolder)
local freeRoamRoot = getOrCreateFolder(remoteRoot, "FreeRoam")
local housingRoot = getOrCreateFolder(freeRoamRoot, "Housing")
local getStateRemote = getOrCreateRemoteFunction(housingRoot, "GetState")
local buyHouseRemote = getOrCreateRemoteFunction(housingRoot, "BuyHouse")
local teleportRemote = getOrCreateRemoteFunction(housingRoot, "TeleportToHouse")
local editModeRemote = getOrCreateRemoteFunction(housingRoot, "SetEditMode")
local styleRemote = getOrCreateRemoteFunction(housingRoot, "SetStyle")
local getEditorStateRemote = getOrCreateRemoteFunction(housingRoot, "GetEditorState")
local purchaseFurnitureRemote = getOrCreateRemoteFunction(housingRoot, "PurchaseFurniture")
local placeFurnitureRemote = getOrCreateRemoteFunction(housingRoot, "PlaceFurniture")
local moveFurnitureRemote = getOrCreateRemoteFunction(housingRoot, "MoveFurniture")
local rotateFurnitureRemote = getOrCreateRemoteFunction(housingRoot, "RotateFurniture")
local removeFurnitureRemote = getOrCreateRemoteFunction(housingRoot, "RemoveFurniture")
local sellFurnitureRemote = getOrCreateRemoteFunction(housingRoot, "SellFurniture")
local paintFurnitureRemote = getOrCreateRemoteFunction(housingRoot, "PaintFurniture")
local hideWallsRemote = getOrCreateRemoteFunction(housingRoot, "SetHideWalls")

local function playerKey(player)
    return tostring(player.UserId)
end

local function openRepository(playerId, reload)
    local repository, openError = EconomyRuntime.open(playerId, reload)
    if repository == nil then
        return nil, tostring(openError or "repository_unavailable")
    end
    return repository, nil
end

local function openLayoutRepository(playerId, reload)
    local repository = layoutRepositoryByPlayerId[playerId]
    if repository == nil then
        local opened, openError = HousingLayoutRepository.open(housingLayoutStore, playerId)
        if opened == nil then
            return nil, tostring(openError or "layout_repository_unavailable")
        end
        repository = opened
        layoutRepositoryByPlayerId[playerId] = repository
    elseif reload == true then
        local ok, reloadError = repository:reload()
        if not ok then
            return nil, tostring(reloadError or "layout_repository_reload_failed")
        end
    end
    return repository, nil
end

local function hasHouse(economyState)
    for _, unlock in ipairs(economyState.ownership or {}) do
        if unlock.category == HOUSE_UNLOCK.category
            and unlock.itemId == HOUSE_UNLOCK.itemId then
            return true
        end
    end
    return false
end

local function setHouseVisual(plotId, visible, styleId, ownerUserId)
    local folder = housingPlotsFolder:FindFirstChild(plotId)
    if not folder then
        return false
    end

    folder:SetAttribute("Claimed", visible == true)
    folder:SetAttribute("OwnerUserId", ownerUserId or 0)
    folder:SetAttribute("StyleId", styleId or "classic-blue")

    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("BasePart") then
            if child.Name:sub(1, 9) == "HouseWall" then
                child.Transparency = visible and 0 or 1
                child.CanCollide = visible
                child.Color = STYLE_COLORS[styleId] or STYLE_COLORS["classic-blue"]
            elseif child.Name == "HouseFloor" then
                child.Transparency = visible and 0 or 1
                child.CanCollide = visible
            elseif child.Name == "HouseRoof" then
                child.Transparency = visible and 0 or 1
                child.CanCollide = visible
            elseif child.Name == "HouseDoor" then
                child.Transparency = visible and 0 or 1
                child.CanCollide = false
            elseif child.Name == "HouseWindow" then
                child.Transparency = visible and 0.25 or 1
                child.CanCollide = false
            end
        end
    end
    return true
end

for _, plot in ipairs(SchoolConfig.HousingPlots) do
    setHouseVisual(plot.id, false, "classic-blue", 0)
end

local PAINT_COLORS = {
    ["default"] = Color3.fromRGB(151, 116, 84),
    ["legacy-blue"] = Color3.fromRGB(92, 132, 204),
    ["legacy-red"] = Color3.fromRGB(183, 127, 119),
    ["legacy-green"] = Color3.fromRGB(145, 171, 132),
    ["legacy-tan"] = Color3.fromRGB(191, 177, 155),
}

local function getFurnitureFolder(plotId)
    local plotFolder = housingPlotsFolder:FindFirstChild(plotId)
    if not plotFolder then return nil end
    local existing = plotFolder:FindFirstChild("EditorFurniture")
    if existing then return existing end
    local folder = Instance.new("Folder")
    folder.Name = "EditorFurniture"
    folder.Parent = plotFolder
    return folder
end

local function setEditorWalls(plotId, hidden)
    local folder = housingPlotsFolder:FindFirstChild(plotId)
    if not folder then return end
    folder:SetAttribute("HideWalls", hidden == true)
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("BasePart") then
            if child.Name:sub(1, 9) == "HouseWall" then
                child.Transparency = hidden and 1 or 0
                child.CanCollide = not hidden
            elseif child.Name == "HouseRoof" then
                child.Transparency = hidden and 0.82 or 0
                child.CanCollide = not hidden
            end
        end
    end
end

local function catalogEntry(catalog, itemId)
    for _, entry in ipairs(catalog or {}) do
        if entry.itemId == itemId then return entry end
    end
    return nil
end

local function shade(color, multiplier)
    return Color3.new(
        math.clamp(color.R * multiplier, 0, 1),
        math.clamp(color.G * multiplier, 0, 1),
        math.clamp(color.B * multiplier, 0, 1)
    )
end

local function furniturePart(model, placement, baseCFrame, spec)
    local part = Instance.new("Part")
    part.Name = spec.name
    part.Size = spec.size
    part.CFrame = baseCFrame * spec.offset
    part.Anchored = true
    part.CanCollide = spec.canCollide == true
    part.CanTouch = false
    part.CanQuery = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Material = spec.material or Enum.Material.Wood
    part.Color = spec.color
    if spec.shape then part.Shape = spec.shape end
    part:SetAttribute("PlacementId", placement.placementId)
    part:SetAttribute("ItemId", placement.itemId)
    part:SetAttribute("FurnitureDetail", spec.name)
    part.Parent = model
    if not model.PrimaryPart then model.PrimaryPart = part end
    return part
end

local function buildFurnitureModel(parent, player, plot, placement, entry)
    local model = Instance.new("Model")
    model.Name = "Furniture_" .. tostring(placement.placementId)
    model:SetAttribute("PlacementId", placement.placementId)
    model:SetAttribute("ItemId", placement.itemId)
    model:SetAttribute("OwnerUserId", player.UserId)
    model:SetAttribute("Geometry", entry.geometry)

    local color = PAINT_COLORS[placement.paintId] or PAINT_COLORS.default
    local dark = shade(color, 0.68)
    local light = shade(color, 1.18)
    local origin = CFrame.new(
        plot.houseOrigin.X + placement.x,
        -- HouseOrigin marks the bottom of the 0.4-stud interior floor.  Lift
        -- each model to its walkable surface so thin décor, especially rugs,
        -- remains visible rather than being embedded below the floor.
        plot.houseOrigin.Y + placement.y + 0.4,
        plot.houseOrigin.Z + placement.z
    ) * CFrame.Angles(0, math.rad(placement.rotation), 0)

    local function add(name, size, x, y, z, material, partColor, canCollide, shape, rotation)
        local offset = CFrame.new(x, y, z)
        if rotation then offset = offset * rotation end
        return furniturePart(model, placement, origin, {
            name = name,
            size = size,
            offset = offset,
            material = material,
            color = partColor or color,
            canCollide = canCollide,
            shape = shape,
        })
    end

    if entry.geometry == "chair" then
        add("Seat", Vector3.new(3.4, 0.5, 3.4), 0, 2.15, 0, Enum.Material.Wood, color, true)
        add("Back", Vector3.new(3.4, 3.1, 0.45), 0, 3.75, 1.48, Enum.Material.Wood, light, true)
        for _, leg in ipairs({
            { -1.35, -1.25 }, { 1.35, -1.25 }, { -1.35, 1.25 }, { 1.35, 1.25 },
        }) do
            add("Leg", Vector3.new(0.36, 2, 0.36), leg[1], 1, leg[2], Enum.Material.Wood, dark, false)
        end
    elseif entry.geometry == "table" then
        add("TableTop", Vector3.new(7, 0.55, 4), 0, 3.15, 0, Enum.Material.Wood, color, true)
        for _, leg in ipairs({
            { -2.75, -1.3 }, { 2.75, -1.3 }, { -2.75, 1.3 }, { 2.75, 1.3 },
        }) do
            add("TableLeg", Vector3.new(0.45, 3, 0.45), leg[1], 1.5, leg[2], Enum.Material.Wood, dark, false)
        end
    elseif entry.geometry == "sofa" then
        add("SofaBase", Vector3.new(8, 1.45, 3.6), 0, 0.75, 0, Enum.Material.Fabric, dark, true)
        add("SeatCushion", Vector3.new(6.6, 0.7, 2.65), 0, 1.75, -0.25, Enum.Material.Fabric, light, true)
        add("SofaBack", Vector3.new(8, 3.2, 0.65), 0, 2.75, 1.48, Enum.Material.Fabric, color, true)
        add("LeftArm", Vector3.new(0.7, 2.2, 3.6), -3.65, 1.45, 0, Enum.Material.Fabric, color, true)
        add("RightArm", Vector3.new(0.7, 2.2, 3.6), 3.65, 1.45, 0, Enum.Material.Fabric, color, true)
    elseif entry.geometry == "lamp" then
        local upright = CFrame.Angles(0, 0, math.rad(90))
        add("LampBase", Vector3.new(0.35, 1.8, 1.8), 0, 0.18, 0, Enum.Material.Metal, dark, false, Enum.PartType.Cylinder, upright)
        add("LampStem", Vector3.new(4.2, 0.28, 0.28), 0, 2.2, 0, Enum.Material.Metal, dark, false, Enum.PartType.Cylinder, upright)
        add("LampShade", Vector3.new(2.5, 1.5, 2.5), 0, 4.5, 0, Enum.Material.Fabric, light, false)
        local bulb = add("WarmBulb", Vector3.new(0.65, 0.65, 0.65), 0, 4.25, 0, Enum.Material.Neon, Color3.fromRGB(255, 236, 190), false, Enum.PartType.Ball)
        local pointLight = Instance.new("PointLight")
        pointLight.Name = "WarmLight"
        pointLight.Brightness = 1.4
        pointLight.Range = 18
        pointLight.Color = Color3.fromRGB(255, 236, 190)
        pointLight.Shadows = true
        pointLight.Parent = bulb
    elseif entry.geometry == "plant" then
        local upright = CFrame.Angles(0, 0, math.rad(90))
        add("Planter", Vector3.new(1.55, 2.15, 2.15), 0, 0.78, 0, Enum.Material.SmoothPlastic, color, true, Enum.PartType.Cylinder, upright)
        add("Stem", Vector3.new(2.7, 0.28, 0.28), 0, 2.45, 0, Enum.Material.Wood, Color3.fromRGB(92, 111, 66), false, Enum.PartType.Cylinder, upright)
        for index, leaf in ipairs({
            { -0.7, 3.35, 0 }, { 0.7, 3.25, 0.1 }, { 0, 4, 0 }, { 0, 3.35, -0.65 }, { 0.1, 3.55, 0.65 },
        }) do
            add("Leaf" .. index, Vector3.new(1.45, 1.1, 1.45), leaf[1], leaf[2], leaf[3], Enum.Material.Grass, Color3.fromRGB(91, 151, 82), false, Enum.PartType.Ball)
        end
    elseif entry.geometry == "rug" then
        add("Rug", Vector3.new(7, 0.16, 5), 0, 0.08, 0, Enum.Material.Fabric, color, false)
        add("RugStripeA", Vector3.new(0.18, 0.04, 4.5), -2.6, 0.18, 0, Enum.Material.Fabric, light, false)
        add("RugStripeB", Vector3.new(0.18, 0.04, 4.5), 2.6, 0.18, 0, Enum.Material.Fabric, light, false)
    elseif entry.geometry == "shelf" then
        add("BookcaseBack", Vector3.new(6, 7, 0.35), 0, 3.5, 0.82, Enum.Material.Wood, dark, true)
        add("BookcaseLeft", Vector3.new(0.45, 7, 2), -2.78, 3.5, 0, Enum.Material.Wood, color, true)
        add("BookcaseRight", Vector3.new(0.45, 7, 2), 2.78, 3.5, 0, Enum.Material.Wood, color, true)
        for index, height in ipairs({ 0.25, 2.35, 4.45, 6.75 }) do
            add("Shelf" .. index, Vector3.new(5.6, 0.35, 2), 0, height, 0, Enum.Material.Wood, color, true)
        end
        for index, book in ipairs({
            { -1.8, 1.15, Color3.fromRGB(71, 119, 173) },
            { -1.15, 1.05, Color3.fromRGB(190, 91, 73) },
            { 0.9, 3.25, Color3.fromRGB(227, 177, 74) },
            { 1.55, 3.15, Color3.fromRGB(84, 151, 109) },
            { -0.5, 5.45, Color3.fromRGB(144, 99, 170) },
        }) do
            add("Book" .. index, Vector3.new(0.48, 1.3, 1.1), book[1], book[2], -0.25, Enum.Material.SmoothPlastic, book[3], false)
        end
    elseif entry.geometry == "bed" then
        add("BedFrame", Vector3.new(7.2, 0.55, 10.2), 0, 0.55, 0, Enum.Material.Wood, dark, true)
        add("Mattress", Vector3.new(6.7, 1.15, 8.9), 0, 1.35, -0.15, Enum.Material.Fabric, light, true)
        add("Headboard", Vector3.new(7.2, 3.7, 0.5), 0, 1.85, 4.85, Enum.Material.Wood, color, true)
        add("Pillow", Vector3.new(5.1, 0.65, 1.55), 0, 2.2, 3.35, Enum.Material.Fabric, Color3.fromRGB(244, 240, 229), false)
        add("Blanket", Vector3.new(6.3, 0.22, 4.6), 0, 2.05, -1.75, Enum.Material.Fabric, color, false)
    else
        add("FurnitureBody", Vector3.new(4, 3, 4), 0, 1.5, 0, Enum.Material.Wood, color, true)
    end

    model.Parent = parent
    return model
end

local function syncEditorVisuals(player, editorState)
    if type(editorState) ~= "table"
        or editorState.accepted ~= true
        or not editorState.plotId then
        return
    end

    local plot = plotConfigById[editorState.plotId]
    local folder = getFurnitureFolder(editorState.plotId)
    if not plot or not folder then return end

    local revision = tonumber(editorState.revision) or -1
    local visualsCurrent = folder:GetAttribute("OwnerUserId") == player.UserId
        and folder:GetAttribute("LayoutRevision") == revision

    if not visualsCurrent then
        folder:ClearAllChildren()
        for _, placement in ipairs(editorState.placements or {}) do
            local entry = catalogEntry(editorState.catalog, placement.itemId)
            if entry then
                buildFurnitureModel(folder, player, plot, placement, entry)
            end
        end
    end

    local hideWalls = editorState.editing == true and editorState.hideWalls == true
    setEditorWalls(editorState.plotId, hideWalls)
    folder:SetAttribute("Editing", editorState.editing == true)
    folder:SetAttribute("OwnerUserId", player.UserId)
    folder:SetAttribute("LayoutRevision", revision)
end


local function ensureClaim(player, ownsHouse)
    local current = lifecycle:get(playerKey(player))
    if ownsHouse ~= true then
        if current then
            setHouseVisual(current.plotId, false, current.styleId, 0)
            local furniture = getFurnitureFolder(current.plotId)
            if furniture then
                furniture:ClearAllChildren()
                furniture:SetAttribute("LayoutRevision", nil)
            end
            lifecycle:release(playerKey(player))
        end
        return nil
    end

    local claim = lifecycle:claim(playerKey(player))
    if claim.accepted and claim.state then
        setHouseVisual(claim.state.plotId, true, claim.state.styleId, player.UserId)
        return claim.state
    end
    return nil
end

local function editorAuthorization(playerId)
    local player = Players:GetPlayerByUserId(playerId)
    if not player then return { owned = false, editing = false } end

    local repository = openRepository(playerId, false)
    if repository == nil then return { owned = false, editing = false } end

    local owned = hasHouse(repository:getState())
    local state = ensureClaim(player, owned)
    return {
        owned = owned,
        editing = state and state.editing == true or false,
        plotId = state and state.plotId or nil,
    }
end

local editorController = HousingEditorController.new({
    layoutRepositoryFactory = function(playerId)
        return openLayoutRepository(playerId, false)
    end,
    economyRepositoryFactory = function(playerId)
        return openRepository(playerId, false)
    end,
    authorize = editorAuthorization,
})

local function discovery(player, reload)
    local repository, repositoryError = openRepository(player.UserId, reload)
    if repository == nil then
        return {
            available = false,
            code = "economy_unavailable",
            error = repositoryError,
            price = HOUSE_PRICE,
        }
    end

    local economyState = repository:getState()
    local owned = hasHouse(economyState)
    local houseState = ensureClaim(player, owned)
    local layoutState = nil
    if owned then
        local layout = openLayoutRepository(player.UserId, reload)
        if layout then
            layoutState = layout:getState()
            if houseState then
                setHouseVisual(
                    houseState.plotId,
                    true,
                    layoutState.houseStyleId or "classic-blue",
                    player.UserId
                )
            end
        end
    end

    local response = {
        available = true,
        owned = owned,
        price = HOUSE_PRICE,
        balance = economyState.balance,
        plotId = houseState and houseState.plotId or nil,
        editing = houseState and houseState.editing == true or false,
        styleId = layoutState and layoutState.houseStyleId or "classic-blue",
        hideWalls = layoutState and layoutState.hideWalls == true or false,
        inventory = layoutState and layoutState.inventory or {},
        placements = layoutState and layoutState.placements or {},
        plotAvailable = owned == false or houseState ~= nil,
        customizationPersistence = "durable_v2",
    }
    if owned and houseState and layoutState then
        response.accepted = true
        response.catalog = editorController:getCatalog()
        syncEditorVisuals(player, response)
        response.accepted = nil
    end
    return response
end

getStateRemote.OnServerInvoke = function(player)
    return discovery(player, false)
end

buyHouseRemote.OnServerInvoke = function(player)
    local repository, repositoryError = openRepository(player.UserId, false)
    if repository == nil then
        return { accepted = false, code = "economy_unavailable", error = repositoryError }
    end

    local economyState = repository:getState()
    if hasHouse(economyState) then
        local state = discovery(player, false)
        state.accepted = true
        state.code = "house_already_owned"
        return state
    end

    local reservation = lifecycle:claim(playerKey(player))
    if not reservation.accepted then
        return { accepted = false, code = reservation.code, price = HOUSE_PRICE }
    end

    local receipt = repository:record({
        operationId = "housing:starter-house:v1",
        playerId = player.UserId,
        delta = -HOUSE_PRICE,
        reason = "housing:purchase",
        unlock = HOUSE_UNLOCK,
    })

    local committed = receipt
        and receipt.durable == true
        and (receipt.status == "applied" or receipt.status == "duplicate")
    if not committed then
        lifecycle:release(playerKey(player))
        local errorCode = receipt and receipt.error or "purchase_failed"
        return {
            accepted = false,
            code = errorCode == "INSUFFICIENT_FUNDS" and "insufficient_funds" or "purchase_failed",
            error = errorCode,
            price = HOUSE_PRICE,
            balance = economyState.balance,
        }
    end

    local houseState = lifecycle:get(playerKey(player))
    setHouseVisual(houseState.plotId, true, houseState.styleId, player.UserId)

    local state = discovery(player, false)
    state.accepted = true
    state.code = receipt.status == "duplicate" and "house_already_owned" or "house_purchased"
    return state
end

teleportRemote.OnServerInvoke = function(player)
    local state = discovery(player, false)
    if state.available ~= true then
        state.accepted = false
        return state
    end
    if state.owned ~= true then
        return { accepted = false, code = "house_not_owned", price = HOUSE_PRICE, balance = state.balance }
    end
    if not state.plotId then
        return { accepted = false, code = "no_plot_available" }
    end

    local plot = plotConfigById[state.plotId]
    local character = player.Character
    if not plot or not character then
        return { accepted = false, code = "teleport_unavailable" }
    end

    character:PivotTo(
        CFrame.new(plot.teleportPosition)
            * CFrame.Angles(0, math.rad(plot.headingDegrees), 0)
    )

    state.accepted = true
    state.code = "teleported_to_house"
    return state
end

editModeRemote.OnServerInvoke = function(player, enabled)
    local state = discovery(player, false)
    if state.owned ~= true or not state.plotId then
        return { accepted = false, code = "house_not_owned" }
    end

    local result = lifecycle:setEditing(playerKey(player), enabled == true)
    if not result.accepted then
        return result
    end

    local updated = discovery(player, false)
    updated.accepted = true
    updated.code = result.code
    local editorState = editorController:getState(player.UserId)
    if editorState.accepted then syncEditorVisuals(player, editorState) end
    return updated
end

styleRemote.OnServerInvoke = function(player, styleId, requestId)
    if STYLE_COLORS[styleId] == nil then
        return { accepted = false, code = "invalid_style" }
    end
    if type(requestId) ~= "string" or requestId == "" then
        return { accepted = false, code = "invalid_request_id" }
    end

    local result = editorController:setHouseStyle(player.UserId, styleId, requestId)
    if result.accepted ~= true then return result end
    setHouseVisual(result.plotId, true, result.houseStyleId, player.UserId)
    syncEditorVisuals(player, result)
    return result
end

local function editorResponse(player, response)
    if type(response) == "table" and response.accepted == true then
        syncEditorVisuals(player, response)
        local economy = openRepository(player.UserId, false)
        if economy then
            response.balance = economy:getState().balance
        end
    end
    return response
end

getEditorStateRemote.OnServerInvoke = function(player)
    return editorResponse(player, editorController:getState(player.UserId))
end

purchaseFurnitureRemote.OnServerInvoke = function(player, itemId, requestId)
    return editorResponse(player, editorController:purchase(player.UserId, itemId, requestId))
end

placeFurnitureRemote.OnServerInvoke = function(player, itemId, transform, requestId)
    return editorResponse(player, editorController:place(player.UserId, itemId, transform, requestId))
end

moveFurnitureRemote.OnServerInvoke = function(player, placementId, transform, requestId)
    return editorResponse(player, editorController:move(player.UserId, placementId, transform, requestId))
end

rotateFurnitureRemote.OnServerInvoke = function(player, placementId, deltaDegrees, requestId)
    return editorResponse(player, editorController:rotate(player.UserId, placementId, deltaDegrees, requestId))
end

removeFurnitureRemote.OnServerInvoke = function(player, placementId, itemId, requestId)
    return editorResponse(player, editorController:remove(player.UserId, placementId, itemId, requestId))
end

sellFurnitureRemote.OnServerInvoke = function(player, itemId, requestId)
    return editorResponse(player, editorController:sellInventory(player.UserId, itemId, requestId))
end

paintFurnitureRemote.OnServerInvoke = function(player, placementId, paintId, requestId)
    return editorResponse(player, editorController:paint(player.UserId, placementId, paintId, requestId))
end

hideWallsRemote.OnServerInvoke = function(player, enabled, requestId)
    return editorResponse(player, editorController:setHideWalls(player.UserId, enabled, requestId))
end

local function restoreOwnedHouse(player)
    local state = discovery(player, false)
    if state.available == true and state.owned == true and state.plotId then
        local lifecycleState = lifecycle:get(playerKey(player))
        setHouseVisual(state.plotId, true, lifecycleState and lifecycleState.styleId or "classic-blue", player.UserId)
    end
end

Players.PlayerAdded:Connect(function(player)
    task.spawn(restoreOwnedHouse, player)
end)

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(restoreOwnedHouse, player)
end

Players.PlayerRemoving:Connect(function(player)
    local current = lifecycle:get(playerKey(player))
    if current then
        setHouseVisual(current.plotId, false, current.styleId, 0)
        local furniture = getFurnitureFolder(current.plotId)
        if furniture then
            furniture:ClearAllChildren()
            furniture:SetAttribute("LayoutRevision", nil)
        end
    end
    lifecycle:release(playerKey(player))
    EconomyRuntime.release(player.UserId)
    layoutRepositoryByPlayerId[player.UserId] = nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="27">
        <Properties>
          <string name="Name">MarketStockJob</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Runtime adapter for the original Pip High Market stock-sorting shift.
-- The server owns proximity, task order, answer checks, request idempotence, and pay.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local SchoolConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SchoolConfig"))
local schoolFoundation = ServerScriptService:WaitForChild("SchoolFoundation")
local EconomyRuntime = require(schoolFoundation:WaitForChild("EconomyRuntime"))
local MarketStockJobController = require(
    schoolFoundation:WaitForChild("MarketStockJobController")
)

local MARKET_RADIUS = 38
local MARKET_WAGE = 45
local market = assert(
    SchoolConfig.WorldLocations.Market,
    "Foundation Market location is required"
)
local random = Random.new()

local controller = MarketStockJobController.new({
    wage = MARKET_WAGE,
    randomInteger = function(minimum, maximum)
        return random:NextInteger(minimum, maximum)
    end,
    shiftIdFactory = function(playerId)
        return "market:" .. tostring(playerId) .. ":" .. HttpService:GenerateGUID(false)
    end,
    taskTokenFactory = function(_playerId, shiftId, step)
        return shiftId
            .. ":"
            .. tostring(step)
            .. ":"
            .. HttpService:GenerateGUID(false)
    end,
    repositoryFactory = function(playerId)
        return EconomyRuntime.open(playerId, false)
    end,
})

local function getOrCreateFolder(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("Folder"), name .. " must be a Folder")
        return existing
    end
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent
    return folder
end

local function getOrCreateRemoteFunction(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("RemoteFunction"), name .. " must be a RemoteFunction")
        return existing
    end
    local remote = Instance.new("RemoteFunction")
    remote.Name = name
    remote.Parent = parent
    return remote
end

local function getOrCreateRemoteEvent(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("RemoteEvent"), name .. " must be a RemoteEvent")
        return existing
    end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = parent
    return remote
end

local function isAtMarket(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then
        return false
    end
    return (root.Position - market.position).Magnitude <= MARKET_RADIUS
end

local remoteRoot = ReplicatedStorage:WaitForChild(SchoolConfig.Interfaces.remoteFolder)
local freeRoamRoot = getOrCreateFolder(remoteRoot, "FreeRoam")
local marketRoot = getOrCreateFolder(freeRoamRoot, "MarketStockJob")
local getStateRemote = getOrCreateRemoteFunction(marketRoot, "GetState")
local startShiftRemote = getOrCreateRemoteFunction(marketRoot, "StartShift")
local submitSortRemote = getOrCreateRemoteFunction(marketRoot, "SubmitSort")
local leaveShiftRemote = getOrCreateRemoteFunction(marketRoot, "LeaveShift")
local openPanelRemote = getOrCreateRemoteEvent(marketRoot, "OpenPanel")

local function decorateState(player, state)
    state.available = true
    state.atMarket = isAtMarket(player)
    state.displayName = market.displayName
    return state
end

local function decorateResponse(player, response)
    response.atMarket = isAtMarket(player)
    response.displayName = market.displayName
    if type(response.state) == "table" then
        decorateState(player, response.state)
    end
    return response
end

local function makeStationPart(model, name, size, cframe, color, material)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = cframe
    part.Color = color
    part.Material = material or Enum.Material.SmoothPlastic
    part.Anchored = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = model
    return part
end

local function buildStockStation()
    local existing = Workspace:FindFirstChild("PipHighMarketStockStation")
    if existing then
        assert(existing:IsA("Model"), "PipHighMarketStockStation must be a Model")
        local existingPrompt = existing:FindFirstChild("MarketStockPrompt", true)
        assert(
            existingPrompt and existingPrompt:IsA("ProximityPrompt"),
            "Market stock station prompt is required"
        )
        return existingPrompt
    end

    local model = Instance.new("Model")
    model.Name = "PipHighMarketStockStation"
    model:SetAttribute("OriginalContent", true)

    local stationCFrame = CFrame.new(market.position + Vector3.new(0, -0.55, 8))
    local counter = makeStationPart(
        model,
        "StockCounter",
        Vector3.new(12, 3.1, 3.6),
        stationCFrame * CFrame.new(0, 0, 0),
        Color3.fromRGB(76, 111, 78),
        Enum.Material.WoodPlanks
    )
    counter.CanCollide = true

    makeStationPart(
        model,
        "CounterTop",
        Vector3.new(12.8, 0.35, 4.2),
        stationCFrame * CFrame.new(0, 1.72, 0),
        Color3.fromRGB(232, 218, 179),
        Enum.Material.Wood
    )

    for index, crateSpec in ipairs({
        { x = -4.3, color = Color3.fromRGB(227, 114, 82) },
        { x = 0, color = Color3.fromRGB(238, 190, 75) },
        { x = 4.3, color = Color3.fromRGB(91, 151, 188) },
    }) do
        makeStationPart(
            model,
            "SortingBin" .. tostring(index),
            Vector3.new(3.2, 1.4, 2.4),
            stationCFrame * CFrame.new(crateSpec.x, 2.55, 0),
            crateSpec.color,
            Enum.Material.SmoothPlastic
        )
    end

    local promptAnchor = makeStationPart(
        model,
        "PromptAnchor",
        Vector3.new(2, 1, 2),
        stationCFrame * CFrame.new(0, 4.8, -1.5),
        Color3.fromRGB(255, 255, 255),
        Enum.Material.SmoothPlastic
    )
    promptAnchor.Transparency = 1
    promptAnchor.CanCollide = false

    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "MarketStockPrompt"
    prompt.ActionText = "Open Stock Shift"
    prompt.ObjectText = market.displayName
    prompt.HoldDuration = 0.2
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.MaxActivationDistance = 14
    prompt.RequiresLineOfSight = false
    prompt.Parent = promptAnchor

    local sign = Instance.new("BillboardGui")
    sign.Name = "StockStationSign"
    sign.Adornee = promptAnchor
    sign.AlwaysOnTop = true
    sign.Size = UDim2.fromOffset(220, 52)
    sign.StudsOffset = Vector3.new(0, 1.7, 0)
    sign.Parent = promptAnchor

    local signText = Instance.new("TextLabel")
    signText.BackgroundColor3 = Color3.fromRGB(44, 74, 52)
    signText.BackgroundTransparency = 0.08
    signText.BorderSizePixel = 0
    signText.Size = UDim2.fromScale(1, 1)
    signText.Font = Enum.Font.GothamBold
    signText.Text = "STOCK SORTING"
    signText.TextColor3 = Color3.fromRGB(255, 247, 218)
    signText.TextScaled = true
    signText.Parent = sign

    local signCorner = Instance.new("UICorner")
    signCorner.CornerRadius = UDim.new(0, 10)
    signCorner.Parent = signText

    model.PrimaryPart = counter
    model.Parent = Workspace
    return prompt
end

local prompt = buildStockStation()
prompt.Triggered:Connect(function(player)
    if isAtMarket(player) then
        openPanelRemote:FireClient(player)
    end
end)

getStateRemote.OnServerInvoke = function(player)
    return decorateState(player, controller:getState(player.UserId))
end

startShiftRemote.OnServerInvoke = function(player)
    return decorateResponse(
        player,
        controller:startShift(player.UserId, isAtMarket(player))
    )
end

submitSortRemote.OnServerInvoke = function(
    player,
    shiftId,
    taskToken,
    choiceId,
    requestId
)
    return decorateResponse(
        player,
        controller:submitSort(
            player.UserId,
            shiftId,
            taskToken,
            choiceId,
            requestId,
            isAtMarket(player)
        )
    )
end

leaveShiftRemote.OnServerInvoke = function(player)
    return decorateResponse(player, controller:leaveShift(player.UserId))
end

Players.PlayerRemoving:Connect(function(player)
    controller:clearPlayer(player.UserId)
    EconomyRuntime.release(player.UserId)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">MarketStockJobController</string>
          <string name="Source"><![CDATA[--!strict
-- Server-only state machine for Pip High's original Market stock-sorting job.
-- Correct aisle answers and the queued task sequence never enter replicated code.

local MarketStockJobController = {}
MarketStockJobController.__index = MarketStockJobController

local JOB_ID = "market-stock"
local STEPS_PER_SHIFT = 3
local DEFAULT_WAGE = 45
local MAX_REQUEST_ID_LENGTH = 64
local MAX_SHIFT_ID_LENGTH = 96
local MAX_TASK_TOKEN_LENGTH = 128
local MAX_REQUEST_CACHE = 24

local TASK_CATALOG = {
    {
        itemLabel = "Crisp apples",
        prompt = "Which aisle keeps these easy to find?",
        correctChoiceId = "produce",
        choices = {
            { id = "produce", label = "Produce" },
            { id = "bakery", label = "Bakery" },
            { id = "chilled", label = "Chilled Goods" },
        },
        hint = "Fresh fruit belongs with other fruits and vegetables.",
        success = "Fresh pick! The apples are ready in Produce.",
    },
    {
        itemLabel = "Cold milk",
        prompt = "Where should this carton be stocked?",
        correctChoiceId = "chilled",
        choices = {
            { id = "chilled", label = "Chilled Goods" },
            { id = "pantry", label = "Pantry" },
            { id = "home_care", label = "Home Care" },
        },
        hint = "Look for the aisle that keeps food cold.",
        success = "Cool choice! The milk is safely chilled.",
    },
    {
        itemLabel = "Study notebooks",
        prompt = "Which section helps students get class-ready?",
        correctChoiceId = "school_supplies",
        choices = {
            { id = "school_supplies", label = "School Supplies" },
            { id = "produce", label = "Produce" },
            { id = "home_care", label = "Home Care" },
        },
        hint = "Think about what you would pack for class.",
        success = "Sharp sorting! The notebooks are with School Supplies.",
    },
    {
        itemLabel = "Fresh bread",
        prompt = "Where will shoppers look for this loaf?",
        correctChoiceId = "bakery",
        choices = {
            { id = "bakery", label = "Bakery" },
            { id = "pantry", label = "Pantry" },
            { id = "chilled", label = "Chilled Goods" },
        },
        hint = "This item was baked today.",
        success = "Nicely done! The fresh loaf is in Bakery.",
    },
    {
        itemLabel = "Breakfast cereal",
        prompt = "Which aisle stores this shelf-stable box?",
        correctChoiceId = "pantry",
        choices = {
            { id = "pantry", label = "Pantry" },
            { id = "bakery", label = "Bakery" },
            { id = "school_supplies", label = "School Supplies" },
        },
        hint = "It stays fresh on a dry grocery shelf.",
        success = "Great match! The cereal is stocked in Pantry.",
    },
    {
        itemLabel = "Dish soap",
        prompt = "Where should this cleaning item go?",
        correctChoiceId = "home_care",
        choices = {
            { id = "home_care", label = "Home Care" },
            { id = "chilled", label = "Chilled Goods" },
            { id = "produce", label = "Produce" },
        },
        hint = "This helps clean things around the home.",
        success = "Spotless sorting! The soap is in Home Care.",
    },
}

local function isInteger(value)
    return type(value) == "number" and value == math.floor(value)
end

local function validPlayerId(playerId)
    return isInteger(playerId) and playerId > 0
end

local function validIdentifier(value, maximumLength)
    return type(value) == "string"
        and #value > 0
        and #value <= maximumLength
        and value:match("^[%w:_%-]+$") ~= nil
end

local function deepCopy(value)
    if type(value) ~= "table" then
        return value
    end
    local copied = {}
    for key, child in pairs(value) do
        copied[key] = deepCopy(child)
    end
    return copied
end

local function copyOperation(operation)
    return {
        operationId = operation.operationId,
        playerId = operation.playerId,
        delta = operation.delta,
        reason = operation.reason,
    }
end

local function shuffledIndices(count, randomInteger)
    local indices = {}
    for index = 1, count do
        indices[index] = index
    end
    for index = count, 2, -1 do
        local swapIndex = randomInteger(1, index)
        assert(
            isInteger(swapIndex) and swapIndex >= 1 and swapIndex <= index,
            "randomInteger returned an out-of-range value"
        )
        indices[index], indices[swapIndex] = indices[swapIndex], indices[index]
    end
    return indices
end

local function publicTask(task)
    local definition = TASK_CATALOG[task.catalogIndex]
    local choices = {}
    for publicIndex, definitionIndex in ipairs(task.choiceOrder) do
        local choice = definition.choices[definitionIndex]
        choices[publicIndex] = {
            id = choice.id,
            label = choice.label,
        }
    end
    return {
        token = task.token,
        itemLabel = definition.itemLabel,
        prompt = definition.prompt,
        choices = choices,
    }
end

local function publicState(active, wage)
    if active == nil then
        return {
            active = false,
            jobId = JOB_ID,
            taskLabel = "Sort three market items",
            completedSteps = 0,
            totalSteps = STEPS_PER_SHIFT,
            wage = wage,
        }
    end

    return {
        active = true,
        jobId = JOB_ID,
        taskLabel = "Sort three market items",
        shiftId = active.shiftId,
        completedSteps = active.step - 1,
        totalSteps = STEPS_PER_SHIFT,
        wage = wage,
        task = publicTask(active.tasks[active.step]),
    }
end

local function sameSignature(left, right)
    return left.shiftId == right.shiftId
        and left.taskToken == right.taskToken
        and left.choiceId == right.choiceId
end

local function committed(receipt)
    return type(receipt) == "table"
        and receipt.durable == true
        and (receipt.status == "applied" or receipt.status == "duplicate")
end

function MarketStockJobController.new(options)
    options = options or {}
    assert(type(options.repositoryFactory) == "function", "repositoryFactory is required")
    assert(type(options.shiftIdFactory) == "function", "shiftIdFactory is required")
    assert(type(options.taskTokenFactory) == "function", "taskTokenFactory is required")

    local wage = options.wage or DEFAULT_WAGE
    assert(isInteger(wage) and wage > 0, "wage must be a positive integer")

    local randomInteger = options.randomInteger or math.random
    assert(type(randomInteger) == "function", "randomInteger must be a function")

    return setmetatable({
        _repositoryFactory = options.repositoryFactory,
        _shiftIdFactory = options.shiftIdFactory,
        _taskTokenFactory = options.taskTokenFactory,
        _randomInteger = randomInteger,
        _wage = wage,
        _active = {},
        _completed = {},
    }, MarketStockJobController)
end

function MarketStockJobController:_buildTasks(playerId, shiftId)
    local catalogOrder = shuffledIndices(#TASK_CATALOG, self._randomInteger)
    local tasks = {}
    local seenTokens = {}
    for step = 1, STEPS_PER_SHIFT do
        local catalogIndex = catalogOrder[step]
        local token = self._taskTokenFactory(playerId, shiftId, step)
        assert(
            validIdentifier(token, MAX_TASK_TOKEN_LENGTH),
            "taskTokenFactory returned an invalid token"
        )
        assert(not seenTokens[token], "taskTokenFactory returned a duplicate token")
        seenTokens[token] = true
        tasks[step] = {
            catalogIndex = catalogIndex,
            token = token,
            choiceOrder = shuffledIndices(
                #TASK_CATALOG[catalogIndex].choices,
                self._randomInteger
            ),
        }
    end
    return tasks
end

function MarketStockJobController:getState(playerId)
    if not validPlayerId(playerId) then
        return {
            active = false,
            available = false,
            code = "invalid_player",
        }
    end
    return publicState(self._active[playerId], self._wage)
end

function MarketStockJobController:startShift(playerId, atMarket)
    if not validPlayerId(playerId) then
        return { accepted = false, code = "invalid_player" }
    end
    if atMarket ~= true then
        return {
            accepted = false,
            code = "not_at_market",
            state = publicState(self._active[playerId], self._wage),
        }
    end

    local existing = self._active[playerId]
    if existing ~= nil then
        return {
            accepted = true,
            code = "shift_already_active",
            state = publicState(existing, self._wage),
        }
    end

    local shiftId = self._shiftIdFactory(playerId)
    if not validIdentifier(shiftId, MAX_SHIFT_ID_LENGTH) then
        return { accepted = false, code = "shift_id_unavailable" }
    end

    local built, tasksOrError = pcall(function()
        return self:_buildTasks(playerId, shiftId)
    end)
    if not built then
        return {
            accepted = false,
            code = "task_sequence_unavailable",
            error = tostring(tasksOrError),
        }
    end

    local active = {
        shiftId = shiftId,
        step = 1,
        tasks = tasksOrError,
        requests = {},
        requestOrder = {},
    }
    self._active[playerId] = active
    self._completed[playerId] = nil
    return {
        accepted = true,
        code = "shift_started",
        feedback = "Apron on! Sort each item into its best aisle.",
        state = publicState(active, self._wage),
    }
end

function MarketStockJobController:_recordWage(playerId, operation)
    local repository, openError = self._repositoryFactory(playerId)
    if repository == nil or type(repository.record) ~= "function" then
        return nil, tostring(openError or "repository_unavailable")
    end
    return repository:record(copyOperation(operation)), nil
end

function MarketStockJobController:_rememberRequest(active, requestId, signature, response)
    active.requests[requestId] = {
        signature = deepCopy(signature),
        response = deepCopy(response),
    }
    table.insert(active.requestOrder, requestId)
    while #active.requestOrder > MAX_REQUEST_CACHE do
        local expiredId = table.remove(active.requestOrder, 1)
        active.requests[expiredId] = nil
    end
end

function MarketStockJobController:_replayActiveRequest(active, requestId, signature)
    local prior = active.requests[requestId]
    if prior == nil then
        return nil
    end
    if not sameSignature(prior.signature, signature) then
        return {
            accepted = false,
            code = "request_conflict",
            state = publicState(active, self._wage),
        }
    end
    local response = deepCopy(prior.response)
    response.replayed = true
    response.state = publicState(active, self._wage)
    return response
end

function MarketStockJobController:_replayCompletedRequest(playerId, completed, requestId, signature)
    if completed.requestId ~= requestId then
        return nil
    end
    if not sameSignature(completed.signature, signature) then
        return {
            accepted = false,
            code = "request_conflict",
            state = publicState(nil, self._wage),
        }
    end

    local receipt, openError = self:_recordWage(playerId, completed.operation)
    if openError ~= nil then
        return {
            accepted = false,
            code = "economy_unavailable",
            error = openError,
            state = publicState(nil, self._wage),
        }
    end
    if not committed(receipt) then
        return {
            accepted = false,
            code = "wage_commit_failed",
            economyStatus = receipt and receipt.status or nil,
            economyError = receipt and receipt.error or "unknown",
            state = publicState(nil, self._wage),
        }
    end

    local response = deepCopy(completed.response)
    response.code = "shift_already_completed"
    response.replayed = true
    response.economyStatus = receipt.status
    response.economyState = receipt.state
    if response.result and receipt.state then
        response.result.balance = receipt.state.balance
    end
    return response
end

function MarketStockJobController:submitSort(
    playerId,
    shiftId,
    taskToken,
    choiceId,
    requestId,
    atMarket
)
    if not validPlayerId(playerId)
        or not validIdentifier(shiftId, MAX_SHIFT_ID_LENGTH)
        or not validIdentifier(taskToken, MAX_TASK_TOKEN_LENGTH)
        or not validIdentifier(choiceId, 32)
        or not validIdentifier(requestId, MAX_REQUEST_ID_LENGTH) then
        return { accepted = false, code = "invalid_sort_request" }
    end

    local active = self._active[playerId]
    local signature = {
        shiftId = shiftId,
        taskToken = taskToken,
        choiceId = choiceId,
    }
    if atMarket ~= true then
        return {
            accepted = false,
            code = "not_at_market",
            state = publicState(active, self._wage),
        }
    end

    if active == nil then
        local completed = self._completed[playerId]
        if completed and completed.shiftId == shiftId then
            local replay = self:_replayCompletedRequest(
                playerId,
                completed,
                requestId,
                signature
            )
            if replay then
                return replay
            end
        end
        return {
            accepted = false,
            code = "no_active_shift",
            state = publicState(nil, self._wage),
        }
    end

    local replay = self:_replayActiveRequest(active, requestId, signature)
    if replay then
        return replay
    end
    if active.shiftId ~= shiftId then
        return {
            accepted = false,
            code = "stale_shift",
            state = publicState(active, self._wage),
        }
    end

    local task = active.tasks[active.step]
    if task.token ~= taskToken then
        return {
            accepted = false,
            code = "stale_task",
            state = publicState(active, self._wage),
        }
    end

    local definition = TASK_CATALOG[task.catalogIndex]
    local knownChoice = false
    for _, choice in ipairs(definition.choices) do
        if choice.id == choiceId then
            knownChoice = true
            break
        end
    end
    if not knownChoice then
        local response = {
            accepted = false,
            code = "invalid_choice",
            feedback = "Choose one of the labeled aisles and try again.",
            state = publicState(active, self._wage),
        }
        self:_rememberRequest(active, requestId, signature, response)
        return response
    end

    if choiceId ~= definition.correctChoiceId then
        local response = {
            accepted = true,
            code = "try_again",
            correct = false,
            feedback = "Almost! " .. definition.hint .. " Try another aisle.",
            state = publicState(active, self._wage),
        }
        self:_rememberRequest(active, requestId, signature, response)
        return response
    end

    if active.step < STEPS_PER_SHIFT then
        active.step = active.step + 1
        local response = {
            accepted = true,
            code = "sort_correct",
            correct = true,
            feedback = definition.success,
            state = publicState(active, self._wage),
        }
        self:_rememberRequest(active, requestId, signature, response)
        return response
    end

    local operation = {
        operationId = "job:market:" .. shiftId,
        playerId = playerId,
        delta = self._wage,
        reason = "job:market-stock",
    }
    local receipt, openError = self:_recordWage(playerId, operation)
    if openError ~= nil then
        return {
            accepted = false,
            code = "economy_unavailable",
            error = openError,
            feedback = "Your work is saved in this shift. Try finishing again.",
            state = publicState(active, self._wage),
        }
    end
    if not committed(receipt) then
        return {
            accepted = false,
            code = "wage_commit_failed",
            economyStatus = receipt and receipt.status or nil,
            economyError = receipt and receipt.error or "unknown",
            feedback = "Your work is still here. Tap the aisle again to retry payment.",
            state = publicState(active, self._wage),
        }
    end

    self._active[playerId] = nil
    local response = {
        accepted = true,
        code = receipt.status == "duplicate" and "shift_completed_replay" or "shift_completed",
        correct = true,
        feedback = definition.success,
        state = publicState(nil, self._wage),
        economyStatus = receipt.status,
        economyState = receipt.state,
        result = {
            title = "Stock star!",
            message = "You sorted all three items and helped the Market run smoothly.",
            completedSteps = STEPS_PER_SHIFT,
            wage = self._wage,
            balance = receipt.state and receipt.state.balance or nil,
        },
    }
    self._completed[playerId] = {
        shiftId = shiftId,
        requestId = requestId,
        signature = deepCopy(signature),
        operation = copyOperation(operation),
        response = deepCopy(response),
    }
    return response
end

function MarketStockJobController:leaveShift(playerId)
    if not validPlayerId(playerId) then
        return { accepted = false, code = "invalid_player" }
    end
    if self._active[playerId] == nil then
        return {
            accepted = true,
            code = "no_active_shift",
            state = publicState(nil, self._wage),
        }
    end

    self._active[playerId] = nil
    return {
        accepted = true,
        code = "shift_left",
        feedback = "Shift paused. You can start a fresh one whenever you are ready.",
        state = publicState(nil, self._wage),
    }
end

function MarketStockJobController:clearPlayer(playerId)
    self._active[playerId] = nil
    self._completed[playerId] = nil
end

return MarketStockJobController
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">OutfitOperations</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Runtime adapter for verified pinned-baseline outfit operations.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local TextService = game:GetService("TextService")

local shared = ReplicatedStorage:WaitForChild("Shared")
local SchoolConfig = require(shared:WaitForChild("SchoolConfig"))
local schoolFoundation = ServerScriptService:WaitForChild("SchoolFoundation")
local ProgressionRepository = require(schoolFoundation:WaitForChild("ProgressionRepository"))
local ProgressionPersistence = require(schoolFoundation:WaitForChild("ProgressionPersistence"))
local OutfitOperationsController = require(schoolFoundation:WaitForChild("OutfitOperationsController"))

local progressionStore = ProgressionPersistence.get()

local function getRepository(playerId)
    return ProgressionRepository.open(progressionStore, playerId)
end

local function filterIdentityForPlayer(player, value)
    if value == "" then return "" end
    local result = TextService:FilterStringAsync(value, player.UserId)
    return result:GetNonChatStringForUserAsync(player.UserId)
end

local function applyOutfit(player, outfit)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false, "HUMANOID_UNAVAILABLE" end

    local description = humanoid:GetAppliedDescription()
    description.Shirt = outfit.RemoveShirt and 0 or outfit.Shirt
    description.Pants = outfit.Pants
    description.Face = outfit.Face

    local hats = {}
    for _, field in ipairs({ "Hat1", "Hat2", "Hat3" }) do
        local assetId = outfit[field]
        if type(assetId) == "number" and assetId > 0 then
            hats[#hats + 1] = tostring(assetId)
        end
    end
    description.HatAccessory = table.concat(hats, ",")

    -- Package is persisted exactly because it is verified baseline state, but
    -- its avatar-application mapping remains unverified and is not guessed here.
    humanoid:ApplyDescription(description)
    return true, nil
end

local function controllerForPlayer(player)
    return OutfitOperationsController.new(
        getRepository,
        function(value, _field)
            return filterIdentityForPlayer(player, value)
        end,
        applyOutfit
    )
end

local function getOrCreateFolder(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("Folder"), name .. " must be a Folder")
        return existing
    end
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent
    return folder
end

local function getOrCreateRemoteFunction(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("RemoteFunction"), name .. " must be a RemoteFunction")
        return existing
    end
    local remote = Instance.new("RemoteFunction")
    remote.Name = name
    remote.Parent = parent
    return remote
end

local remoteRoot = ReplicatedStorage:WaitForChild(SchoolConfig.Interfaces.remoteFolder)
local freeRoam = getOrCreateFolder(remoteRoot, "FreeRoam")
local outfitRoot = getOrCreateFolder(freeRoam, "Outfits")
local loadOutfit = getOrCreateRemoteFunction(outfitRoot, "LoadOutfit")
local loadOutfitPage = getOrCreateRemoteFunction(outfitRoot, "LoadOutfitPage")
local getFilteredNamesForOutfit = getOrCreateRemoteFunction(outfitRoot, "GetFilteredNamesForOutfit")
local wearOutfit = getOrCreateRemoteFunction(outfitRoot, "WearOutfit")
local saveOutfit = getOrCreateRemoteFunction(outfitRoot, "SaveOutfit")

loadOutfit.OnServerInvoke = function(player, slot)
    return controllerForPlayer(player):loadOutfit(player.UserId, slot)
end

loadOutfitPage.OnServerInvoke = function(player, startSlot)
    return controllerForPlayer(player):loadOutfitPage(player.UserId, startSlot)
end

getFilteredNamesForOutfit.OnServerInvoke = function(player, input)
    return controllerForPlayer(player):getFilteredNamesForOutfit(input)
end

wearOutfit.OnServerInvoke = function(player, slot)
    return controllerForPlayer(player):wearOutfit(player.UserId, slot, player)
end

saveOutfit.OnServerInvoke = function(player, slot, input, requestId)
    return controllerForPlayer(player):saveOutfit(player.UserId, slot, input, requestId)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">OutfitOperationsController</string>
          <string name="Source"><![CDATA[--!strict
-- Server-authoritative pinned-baseline outfit operations.
-- Persistence remains owned by ProgressionRepository; this module only validates,
-- filters, and coordinates the verified Legacy outfit operation semantics.

local Controller = {}
Controller.__index = Controller

local LEGACY_PRESENTED_SLOT_COUNT = 12
local OUTFIT_NAME_MAX_LENGTH = 25
local INVALID_NAME = "INVALID_NAME"
local NOLOAD = "noload"
local PAGE_STARTS = { [1] = true, [4] = true, [7] = true, [10] = true }

local DEFAULTS = {
    OutfitName = "",
    Hat1 = 0,
    Hat2 = 0,
    Hat3 = 0,
    Shirt = 0,
    Pants = 0,
    Face = 0,
    Package = 0,
    RPName = "",
    RPDesc = "",
    RemoveShirt = false,
}

local FILTERED_FIELDS = {
    OutfitName = true,
    RPName = true,
    RPDesc = true,
}

local FILTERED_FALLBACKS = {
    OutfitName = "Saved Outfit",
    RPName = "RP Name Here",
    RPDesc = "RP Desc Here",
}

local function isInteger(value)
    return type(value) == "number" and value == math.floor(value)
end

local function validPresentedSlot(slot)
    return isInteger(slot) and slot >= 1 and slot <= LEGACY_PRESENTED_SLOT_COUNT
end

local function isEmptyOutfit(outfit)
    if type(outfit) ~= "table" then return true end
    return outfit.OutfitName == ""
        and outfit.Hat1 == 0
        and outfit.Hat2 == 0
        and outfit.Hat3 == 0
        and outfit.Shirt == 0
        and outfit.Pants == 0
        and outfit.Face == 0
        and outfit.Package == 0
        and outfit.RPName == ""
        and outfit.RPDesc == ""
        and outfit.RemoveShirt == false
end

local function filterNames(input, filterIdentity)
    if type(input) ~= "table" then return nil, "INVALID_OUTFIT" end
    local rawName = input.OutfitName
    if rawName == nil then rawName = "" end
    if type(rawName) ~= "string" then return nil, "INVALID_OUTFIT_FIELD:OutfitName" end
    if #rawName > OUTFIT_NAME_MAX_LENGTH then return nil, INVALID_NAME end

    local filtered = {}
    for _, field in ipairs({ "OutfitName", "RPName", "RPDesc" }) do
        local value = input[field]
        if value == nil then value = "" end
        if type(value) ~= "string" then return nil, "INVALID_OUTFIT_FIELD:" .. field end
        local ok, result = pcall(filterIdentity, value, field)
        if not ok or type(result) ~= "string" then return nil, "FILTER_FAILED:" .. field end
        if result:match("^%s*$") then result = FILTERED_FALLBACKS[field] end
        filtered[field] = result
    end
    return filtered, nil
end

local function sanitizeOutfit(input, filterIdentity)
    if type(input) ~= "table" then return nil, "INVALID_OUTFIT" end
    local outfit = {}
    for field, defaultValue in pairs(DEFAULTS) do
        local value = input[field]
        if value == nil then value = defaultValue end

        if type(value) ~= type(defaultValue) then
            return nil, "INVALID_OUTFIT_FIELD:" .. field
        end
        if type(defaultValue) == "number" then
            if not isInteger(value) or value < 0 then
                return nil, "INVALID_OUTFIT_FIELD:" .. field
            end
        elseif FILTERED_FIELDS[field] then
            -- Applied in one server-owned batch below so verified fallbacks and
            -- OutfitName length semantics are consistent across the seam.
        end
        outfit[field] = value
    end

    local filtered, filterError = filterNames(input, filterIdentity)
    if not filtered then return nil, filterError end
    outfit.OutfitName = filtered.OutfitName
    outfit.RPName = filtered.RPName
    outfit.RPDesc = filtered.RPDesc
    return outfit, nil
end

function Controller.new(repositoryFactory, filterIdentity, applyOutfit)
    assert(type(repositoryFactory) == "function", "repositoryFactory is required")
    assert(type(filterIdentity) == "function", "filterIdentity is required")
    assert(type(applyOutfit) == "function", "applyOutfit is required")
    return setmetatable({
        _repositoryFactory = repositoryFactory,
        _filterIdentity = filterIdentity,
        _applyOutfit = applyOutfit,
    }, Controller)
end

function Controller:_repo(playerId)
    local repository, openError = self._repositoryFactory(playerId)
    if not repository then
        return nil, tostring(openError or "OUTFIT_REPOSITORY_UNAVAILABLE")
    end
    return repository, nil
end

function Controller:loadOutfit(playerId, slot)
    if not validPresentedSlot(slot) then
        return { accepted = false, code = "invalid_outfit_slot" }
    end
    local repository, openError = self:_repo(playerId)
    if not repository then
        return { accepted = false, code = "outfit_persistence_unavailable", error = openError }
    end
    local outfit, loadError = repository:loadOutfit(slot)
    if not outfit then
        return { accepted = false, code = "outfit_load_failed", error = loadError }
    end
    if isEmptyOutfit(outfit) then
        return { accepted = true, slot = slot, status = NOLOAD, outfit = outfit }
    end
    return { accepted = true, slot = slot, status = "load", outfit = outfit }
end

function Controller:loadOutfitPage(playerId, startSlot)
    if PAGE_STARTS[startSlot] ~= true then
        return { accepted = false, code = "invalid_outfit_page" }
    end
    local repository, openError = self:_repo(playerId)
    if not repository then
        return { accepted = false, code = "outfit_persistence_unavailable", error = openError }
    end
    local page, loadError = repository:loadOutfitPage(startSlot)
    if not page then
        return { accepted = false, code = "outfit_page_load_failed", error = loadError }
    end
    for _, item in ipairs(page) do
        item.status = isEmptyOutfit(item.outfit) and NOLOAD or "load"
    end
    return { accepted = true, startSlot = startSlot, outfits = page }
end

function Controller:getFilteredNamesForOutfit(input)
    local filtered, filterError = filterNames(input, self._filterIdentity)
    if not filtered then
        return {
            accepted = false,
            code = filterError == INVALID_NAME and INVALID_NAME or "invalid_outfit_names",
            status = filterError == INVALID_NAME and INVALID_NAME or nil,
            error = filterError,
        }
    end
    return {
        accepted = true,
        OutfitName = filtered.OutfitName,
        RPName = filtered.RPName,
        RPDesc = filtered.RPDesc,
    }
end

function Controller:saveOutfit(playerId, slot, input, requestId)
    if not validPresentedSlot(slot) then
        return { accepted = false, code = "invalid_outfit_slot" }
    end
    local outfit, validationError = sanitizeOutfit(input, self._filterIdentity)
    if not outfit then
        return {
            accepted = false,
            code = validationError == INVALID_NAME and INVALID_NAME or "invalid_outfit",
            status = validationError == INVALID_NAME and INVALID_NAME or nil,
            error = validationError,
        }
    end

    local repository, openError = self:_repo(playerId)
    if not repository then
        return { accepted = false, code = "outfit_persistence_unavailable", error = openError }
    end
    local receipt = repository:saveOutfit(slot, outfit, requestId)
    if receipt.durable ~= true then
        return {
            accepted = false,
            code = "outfit_save_failed",
            error = receipt.error,
            retryable = receipt.error == "STALE_WRITE_RETRY_EXHAUSTED"
                or (type(receipt.error) == "string" and receipt.error:find("SAVE_FAILED:", 1, true) == 1),
        }
    end
    return {
        accepted = true,
        slot = slot,
        outfit = receipt.outfit,
        revision = receipt.revision,
        duplicate = receipt.status == "duplicate",
    }
end

function Controller:wearOutfit(playerId, slot, player)
    local loaded = self:loadOutfit(playerId, slot)
    if loaded.accepted ~= true then return loaded end
    if loaded.status == NOLOAD then
        return { accepted = false, code = NOLOAD, status = NOLOAD, slot = slot }
    end
    local ok, applyError = self._applyOutfit(player, loaded.outfit)
    if ok ~= true then
        return { accepted = false, code = "outfit_apply_failed", error = tostring(applyError or "unknown") }
    end
    return { accepted = true, slot = slot, outfit = loaded.outfit }
end

Controller.LEGACY_PRESENTED_SLOT_COUNT = LEGACY_PRESENTED_SLOT_COUNT
Controller.OUTFIT_NAME_MAX_LENGTH = OUTFIT_NAME_MAX_LENGTH
Controller.INVALID_NAME = INVALID_NAME
Controller.NOLOAD = NOLOAD
Controller.PAGE_STARTS = { 1, 4, 7, 10 }
Controller.DEFAULTS = DEFAULTS
Controller.FILTERED_FIELDS = { "OutfitName", "RPName", "RPDesc" }
Controller.FILTERED_FALLBACKS = FILTERED_FALLBACKS

return Controller
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">PEDodgeballController</string>
          <string name="Source"><![CDATA[--!strict
-- Pure authoritative state and geometry for the Pip High P.E. dodgeball drill.
-- Roblox instances and replication live only in the server runtime adapter.

local PEDodgeballController = {}
PEDodgeballController.__index = PEDodgeballController

local DEFAULT_DURATION = 15
local DEFAULT_FIRST_BALL_DELAY = 0.75
local DEFAULT_BALL_INTERVAL = 1.35
local DEFAULT_START_COOLDOWN = 0.75
local MAX_SESSION_ID_LENGTH = 96

local function finiteNumber(value)
    return type(value) == "number"
        and value == value
        and value ~= math.huge
        and value ~= -math.huge
end

local function isInteger(value)
    return finiteNumber(value) and value == math.floor(value)
end

local function validPlayerId(playerId)
    return isInteger(playerId) and playerId > 0
end

local function validIdentifier(value, maximumLength)
    return type(value) == "string"
        and #value > 0
        and #value <= maximumLength
        and value:match("^[%w:_%-]+$") ~= nil
end

local function validPoint(point)
    return type(point) == "table"
        and finiteNumber(point.x)
        and finiteNumber(point.y)
        and finiteNumber(point.z)
end

local function calculateTotalBalls(duration, firstBallDelay, ballInterval)
    local count = 0
    local scheduledAt = firstBallDelay
    while scheduledAt < duration do
        count = count + 1
        scheduledAt = scheduledAt + ballInterval
    end
    return count
end

local function gradeForHits(hits)
    if hits == 0 then
        return "A+", "Perfect footwork! You stayed clear of every foam ball."
    elseif hits == 1 then
        return "A", "Great movement! One tap could not slow you down."
    elseif hits == 2 then
        return "B", "Strong dodging! Keep changing direction and watching the lanes."
    end
    return "C", "Drill complete! Keep moving early and you will dodge even more next time."
end

local function inactiveState(duration, totalBalls)
    return {
        active = false,
        duration = duration,
        remainingSeconds = 0,
        hits = 0,
        ballsThrown = 0,
        totalBalls = totalBalls,
    }
end

local function publicState(session, now, duration, totalBalls)
    if session == nil then
        return inactiveState(duration, totalBalls)
    end
    return {
        active = true,
        duration = duration,
        remainingSeconds = math.max(0, session.endAt - now),
        hits = session.hits,
        ballsThrown = session.ballsThrown,
        totalBalls = totalBalls,
    }
end

function PEDodgeballController.computeBallisticVelocity(
    origin,
    target,
    flightTime,
    effectiveGravity
)
    assert(validPoint(origin), "origin must be a finite point")
    assert(validPoint(target), "target must be a finite point")
    assert(finiteNumber(flightTime) and flightTime > 0, "flightTime must be positive")
    assert(
        finiteNumber(effectiveGravity) and effectiveGravity >= 0,
        "effectiveGravity must be non-negative"
    )

    return {
        x = (target.x - origin.x) / flightTime,
        y = (
            target.y
            - origin.y
            + 0.5 * effectiveGravity * flightTime * flightTime
        ) / flightTime,
        z = (target.z - origin.z) / flightTime,
    }
end

function PEDodgeballController.segmentHitsSphere(
    segmentStart,
    segmentEnd,
    sphereCenter,
    radius
)
    assert(validPoint(segmentStart), "segmentStart must be a finite point")
    assert(validPoint(segmentEnd), "segmentEnd must be a finite point")
    assert(validPoint(sphereCenter), "sphereCenter must be a finite point")
    assert(finiteNumber(radius) and radius >= 0, "radius must be non-negative")

    local dx = segmentEnd.x - segmentStart.x
    local dy = segmentEnd.y - segmentStart.y
    local dz = segmentEnd.z - segmentStart.z
    local lengthSquared = dx * dx + dy * dy + dz * dz
    local closestT = 0
    if lengthSquared > 0 then
        closestT = (
            (sphereCenter.x - segmentStart.x) * dx
            + (sphereCenter.y - segmentStart.y) * dy
            + (sphereCenter.z - segmentStart.z) * dz
        ) / lengthSquared
        closestT = math.max(0, math.min(1, closestT))
    end

    local closestX = segmentStart.x + dx * closestT
    local closestY = segmentStart.y + dy * closestT
    local closestZ = segmentStart.z + dz * closestT
    local distanceX = sphereCenter.x - closestX
    local distanceY = sphereCenter.y - closestY
    local distanceZ = sphereCenter.z - closestZ
    return distanceX * distanceX + distanceY * distanceY + distanceZ * distanceZ
        <= radius * radius
end

function PEDodgeballController.new(options)
    options = options or {}
    assert(type(options.sessionIdFactory) == "function", "sessionIdFactory is required")

    local duration = options.duration or DEFAULT_DURATION
    local firstBallDelay = options.firstBallDelay or DEFAULT_FIRST_BALL_DELAY
    local ballInterval = options.ballInterval or DEFAULT_BALL_INTERVAL
    local startCooldown = options.startCooldown or DEFAULT_START_COOLDOWN
    assert(finiteNumber(duration) and duration > 0, "duration must be positive")
    assert(
        finiteNumber(firstBallDelay) and firstBallDelay >= 0 and firstBallDelay < duration,
        "firstBallDelay must be within the round"
    )
    assert(finiteNumber(ballInterval) and ballInterval > 0, "ballInterval must be positive")
    assert(finiteNumber(startCooldown) and startCooldown >= 0, "startCooldown must be non-negative")

    return setmetatable({
        _sessionIdFactory = options.sessionIdFactory,
        _duration = duration,
        _firstBallDelay = firstBallDelay,
        _ballInterval = ballInterval,
        _startCooldown = startCooldown,
        _totalBalls = calculateTotalBalls(duration, firstBallDelay, ballInterval),
        _active = {},
        _lastStartAt = {},
    }, PEDodgeballController)
end

function PEDodgeballController:getState(playerId, now)
    if not validPlayerId(playerId) or not finiteNumber(now) then
        local state = inactiveState(self._duration, self._totalBalls)
        state.available = false
        state.code = "invalid_state_request"
        return state
    end
    return publicState(
        self._active[playerId],
        now,
        self._duration,
        self._totalBalls
    )
end

function PEDodgeballController:startSession(playerId, atGym, alive, now)
    if not validPlayerId(playerId) or not finiteNumber(now) then
        return { accepted = false, code = "invalid_start" }
    end
    if atGym ~= true then
        return {
            accepted = false,
            code = "not_at_gym",
            state = self:getState(playerId, now),
        }
    end
    if alive ~= true then
        return {
            accepted = false,
            code = "player_not_ready",
            state = self:getState(playerId, now),
        }
    end

    local current = self._active[playerId]
    if current then
        return {
            accepted = true,
            code = "session_already_active",
            sessionId = current.sessionId,
            state = publicState(current, now, self._duration, self._totalBalls),
        }
    end

    local lastStartAt = self._lastStartAt[playerId]
    if lastStartAt ~= nil and now - lastStartAt < self._startCooldown then
        return {
            accepted = false,
            code = "start_rate_limited",
            retryAfter = math.max(0, self._startCooldown - (now - lastStartAt)),
            state = self:getState(playerId, now),
        }
    end

    local sessionId = self._sessionIdFactory(playerId, now)
    if not validIdentifier(sessionId, MAX_SESSION_ID_LENGTH) then
        return { accepted = false, code = "session_id_unavailable" }
    end

    local session = {
        sessionId = sessionId,
        startedAt = now,
        endAt = now + self._duration,
        nextBallAt = now + self._firstBallDelay,
        nextBallNumber = 1,
        ballsThrown = 0,
        hits = 0,
        spawnedBallIds = {},
        hitBallIds = {},
    }
    self._active[playerId] = session
    self._lastStartAt[playerId] = now
    return {
        accepted = true,
        code = "session_started",
        sessionId = sessionId,
        state = publicState(session, now, self._duration, self._totalBalls),
    }
end

function PEDodgeballController:_finish(playerId, session, reason, now, completed)
    self._active[playerId] = nil
    if completed then
        session.ballsThrown = self._totalBalls
    end

    local dodged = math.max(0, session.ballsThrown - session.hits)
    local grade = nil
    local message
    local title
    if completed then
        grade, message = gradeForHits(session.hits)
        title = "Drill complete!"
    else
        title = "Drill ended safely"
        message = "No penalty. Return to the gym prompt whenever you want another try."
    end

    return {
        accepted = true,
        code = completed and "session_completed" or "session_ended",
        state = inactiveState(self._duration, self._totalBalls),
        result = {
            completed = completed,
            reason = reason,
            title = title,
            message = message,
            grade = grade,
            hits = session.hits,
            dodged = dodged,
            ballsThrown = session.ballsThrown,
            totalBalls = self._totalBalls,
            duration = self._duration,
        },
    }
end

function PEDodgeballController:advance(playerId, now, atGym, alive)
    if not validPlayerId(playerId) or not finiteNumber(now) then
        return { accepted = false, code = "invalid_advance" }
    end
    local session = self._active[playerId]
    if session == nil then
        return {
            accepted = false,
            code = "no_active_session",
            state = self:getState(playerId, now),
        }
    end
    if alive ~= true then
        return self:_finish(playerId, session, "player_died", now, false)
    end
    if atGym ~= true then
        return self:_finish(playerId, session, "left_gym", now, false)
    end
    if now >= session.endAt then
        return self:_finish(playerId, session, "completed", now, true)
    end

    local spawnBallIds = {}
    while session.nextBallAt <= now
        and session.nextBallNumber <= self._totalBalls do
        local ballId = session.sessionId
            .. ":ball-"
            .. tostring(session.nextBallNumber)
        session.spawnedBallIds[ballId] = true
        table.insert(spawnBallIds, ballId)
        session.ballsThrown = session.ballsThrown + 1
        session.nextBallNumber = session.nextBallNumber + 1
        session.nextBallAt = session.nextBallAt + self._ballInterval
    end

    return {
        accepted = true,
        code = "session_updated",
        sessionId = session.sessionId,
        spawnBallIds = spawnBallIds,
        state = publicState(session, now, self._duration, self._totalBalls),
    }
end

function PEDodgeballController:recordHit(playerId, sessionId, ballId, now)
    if not validPlayerId(playerId)
        or not validIdentifier(sessionId, MAX_SESSION_ID_LENGTH)
        or not validIdentifier(ballId, MAX_SESSION_ID_LENGTH + 24)
        or not finiteNumber(now) then
        return { accepted = false, code = "invalid_hit" }
    end

    local session = self._active[playerId]
    if session == nil then
        return { accepted = false, code = "no_active_session" }
    end
    if session.sessionId ~= sessionId then
        return { accepted = false, code = "stale_session" }
    end
    if now >= session.endAt then
        return { accepted = false, code = "session_expired" }
    end
    if session.spawnedBallIds[ballId] ~= true then
        return { accepted = false, code = "unknown_ball" }
    end
    if session.hitBallIds[ballId] then
        return {
            accepted = true,
            code = "hit_already_recorded",
            state = publicState(session, now, self._duration, self._totalBalls),
        }
    end

    session.hitBallIds[ballId] = true
    session.hits = session.hits + 1
    return {
        accepted = true,
        code = "hit_recorded",
        state = publicState(session, now, self._duration, self._totalBalls),
    }
end

function PEDodgeballController:endSession(playerId, reason, now)
    if not validPlayerId(playerId)
        or type(reason) ~= "string"
        or reason == ""
        or not finiteNumber(now) then
        return { accepted = false, code = "invalid_end" }
    end
    local session = self._active[playerId]
    if session == nil then
        return {
            accepted = true,
            code = "no_active_session",
            state = self:getState(playerId, now),
        }
    end
    return self:_finish(playerId, session, reason, now, reason == "completed")
end

function PEDodgeballController:clearPlayer(playerId)
    self._active[playerId] = nil
    self._lastStartAt[playerId] = nil
end

return PEDodgeballController
]]></string>
