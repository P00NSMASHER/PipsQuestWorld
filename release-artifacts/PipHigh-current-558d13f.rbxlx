local closeButton = Instance.new("TextButton")
closeButton.Name = "Close"
closeButton.AnchorPoint = Vector2.new(1, 0.5)
closeButton.BackgroundColor3 = COLORS.headerDark
closeButton.BorderSizePixel = 0
closeButton.Position = UDim2.new(1, -14, 0.5, 0)
closeButton.Size = UDim2.fromOffset(38, 38)
closeButton.Font = Enum.Font.GothamBold
closeButton.Text = "X"
closeButton.TextColor3 = COLORS.white
closeButton.TextSize = 16
closeButton.Parent = header
addCorner(closeButton, 10)

local body = Instance.new("ScrollingFrame")
body.Name = "Content"
body.Active = true
body.BackgroundTransparency = 1
body.BorderSizePixel = 0
body.CanvasSize = UDim2.fromOffset(0, 370)
body.Position = UDim2.fromOffset(0, 62)
body.ScrollBarImageColor3 = COLORS.header
body.ScrollBarThickness = 5
body.Size = UDim2.new(1, 0, 1, -128)
body.Parent = panel

local progressLabel = Instance.new("TextLabel")
progressLabel.BackgroundColor3 = COLORS.softGold
progressLabel.BorderSizePixel = 0
progressLabel.Position = UDim2.fromOffset(16, 14)
progressLabel.Size = UDim2.new(1, -32, 0, 30)
progressLabel.Font = Enum.Font.GothamBold
progressLabel.Text = "READY FOR A 3-ITEM SHIFT"
progressLabel.TextColor3 = COLORS.accentDark
progressLabel.TextSize = 13
progressLabel.Parent = body
addCorner(progressLabel, 9)

local taskCard = Instance.new("Frame")
taskCard.Name = "TaskCard"
taskCard.BackgroundColor3 = COLORS.card
taskCard.BorderSizePixel = 0
taskCard.Position = UDim2.fromOffset(16, 56)
taskCard.Size = UDim2.new(1, -32, 0, 104)
taskCard.Parent = body
addCorner(taskCard, 12)
addStroke(taskCard, COLORS.line, 1, 0.15)

local itemLabel = Instance.new("TextLabel")
itemLabel.BackgroundTransparency = 1
itemLabel.Position = UDim2.fromOffset(16, 12)
itemLabel.Size = UDim2.new(1, -32, 0, 32)
itemLabel.Font = Enum.Font.GothamBold
itemLabel.Text = "Ready to help?"
itemLabel.TextColor3 = COLORS.ink
itemLabel.TextSize = 22
itemLabel.TextWrapped = true
itemLabel.TextXAlignment = Enum.TextXAlignment.Left
itemLabel.Parent = taskCard

local promptLabel = Instance.new("TextLabel")
promptLabel.BackgroundTransparency = 1
promptLabel.Position = UDim2.fromOffset(16, 50)
promptLabel.Size = UDim2.new(1, -32, 0, 42)
promptLabel.Font = Enum.Font.Gotham
promptLabel.Text = "Start a short shift and sort three items. Wrong answers only give a helpful hint."
promptLabel.TextColor3 = COLORS.muted
promptLabel.TextSize = 14
promptLabel.TextWrapped = true
promptLabel.TextXAlignment = Enum.TextXAlignment.Left
promptLabel.TextYAlignment = Enum.TextYAlignment.Top
promptLabel.Parent = taskCard

local choicesFrame = Instance.new("Frame")
choicesFrame.Name = "AisleChoices"
choicesFrame.BackgroundTransparency = 1
choicesFrame.Position = UDim2.fromOffset(16, 172)
choicesFrame.Size = UDim2.new(1, -32, 0, 150)
choicesFrame.Parent = body

local choicesLayout = Instance.new("UIListLayout")
choicesLayout.Padding = UDim.new(0, 8)
choicesLayout.SortOrder = Enum.SortOrder.LayoutOrder
choicesLayout.Parent = choicesFrame

local choiceButtons = {}
for index = 1, 3 do
    local button = Instance.new("TextButton")
    button.Name = "AisleChoice" .. tostring(index)
    button.LayoutOrder = index
    button.Size = UDim2.new(1, 0, 0, 44)
    button.Text = "AISLE"
    button.Visible = false
    button.Parent = choicesFrame
    styleButton(button, Color3.fromRGB(235, 241, 229), COLORS.headerDark)
    choiceButtons[index] = button
end

local feedbackLabel = Instance.new("TextLabel")
feedbackLabel.Name = "Feedback"
feedbackLabel.BackgroundColor3 = COLORS.softGreen
feedbackLabel.BorderSizePixel = 0
feedbackLabel.Position = UDim2.fromOffset(16, 330)
feedbackLabel.Size = UDim2.new(1, -32, 0, 40)
feedbackLabel.Font = Enum.Font.Gotham
feedbackLabel.Text = "Use the stock station prompt whenever you want to work."
feedbackLabel.TextColor3 = COLORS.headerDark
feedbackLabel.TextSize = 13
feedbackLabel.TextWrapped = true
feedbackLabel.Parent = body
addCorner(feedbackLabel, 9)

local resultCard = Instance.new("Frame")
resultCard.Name = "ResultCard"
resultCard.BackgroundColor3 = COLORS.softGreen
resultCard.BorderSizePixel = 0
resultCard.Position = UDim2.fromOffset(16, 56)
resultCard.Size = UDim2.new(1, -32, 0, 266)
resultCard.Visible = false
resultCard.Parent = body
addCorner(resultCard, 14)
addStroke(resultCard, COLORS.positive, 2, 0.45)

local resultTitle = Instance.new("TextLabel")
resultTitle.BackgroundTransparency = 1
resultTitle.Position = UDim2.fromOffset(18, 20)
resultTitle.Size = UDim2.new(1, -36, 0, 38)
resultTitle.Font = Enum.Font.GothamBold
resultTitle.Text = "STOCK STAR!"
resultTitle.TextColor3 = COLORS.positive
resultTitle.TextSize = 26
resultTitle.Parent = resultCard

local resultMessage = Instance.new("TextLabel")
resultMessage.BackgroundTransparency = 1
resultMessage.Position = UDim2.fromOffset(24, 68)
resultMessage.Size = UDim2.new(1, -48, 0, 62)
resultMessage.Font = Enum.Font.Gotham
resultMessage.Text = "You sorted all three items and helped the Market run smoothly."
resultMessage.TextColor3 = COLORS.ink
resultMessage.TextSize = 15
resultMessage.TextWrapped = true
resultMessage.Parent = resultCard

local rewardLabel = Instance.new("TextLabel")
rewardLabel.BackgroundColor3 = COLORS.accent
rewardLabel.BorderSizePixel = 0
rewardLabel.Position = UDim2.new(0.5, -110, 0, 146)
rewardLabel.Size = UDim2.fromOffset(220, 48)
rewardLabel.Font = Enum.Font.GothamBold
rewardLabel.Text = "+$45 SHIFT PAY"
rewardLabel.TextColor3 = COLORS.accentDark
rewardLabel.TextSize = 19
rewardLabel.Parent = resultCard
addCorner(rewardLabel, 12)

local balanceLabel = Instance.new("TextLabel")
balanceLabel.BackgroundTransparency = 1
balanceLabel.Position = UDim2.fromOffset(18, 208)
balanceLabel.Size = UDim2.new(1, -36, 0, 28)
balanceLabel.Font = Enum.Font.GothamBold
balanceLabel.Text = "New balance: --"
balanceLabel.TextColor3 = COLORS.headerDark
balanceLabel.TextSize = 15
balanceLabel.Parent = resultCard

local footer = Instance.new("Frame")
footer.Name = "Footer"
footer.AnchorPoint = Vector2.new(0, 1)
footer.BackgroundColor3 = Color3.fromRGB(237, 234, 220)
footer.BorderSizePixel = 0
footer.Position = UDim2.fromScale(0, 1)
footer.Size = UDim2.new(1, 0, 0, 66)
footer.Parent = panel

local footerLine = Instance.new("Frame")
footerLine.BackgroundColor3 = COLORS.line
footerLine.BorderSizePixel = 0
footerLine.Size = UDim2.new(1, 0, 0, 1)
footerLine.Parent = footer

local leaveButton = Instance.new("TextButton")
leaveButton.Name = "LeaveShift"
leaveButton.Position = UDim2.fromOffset(14, 12)
leaveButton.Size = UDim2.new(0.38, -7, 0, 42)
leaveButton.Text = "LEAVE SHIFT"
leaveButton.Visible = false
leaveButton.Parent = footer
styleButton(leaveButton, Color3.fromRGB(222, 224, 218), COLORS.muted)

local primaryButton = Instance.new("TextButton")
primaryButton.Name = "PrimaryAction"
primaryButton.Position = UDim2.fromOffset(14, 12)
primaryButton.Size = UDim2.new(1, -28, 0, 42)
primaryButton.Text = "START 3-ITEM SHIFT"
primaryButton.Parent = footer
styleButton(primaryButton, COLORS.accent, COLORS.accentDark)

-- Keep the fixed header and footer reachable on the minimum 480x300 phone
-- viewport. The task cards stay in the scrolling middle region, while larger
-- windows retain the original desktop proportions.
local viewportConnection = nil
local function applyResponsiveLayout()
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local viewport = camera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return end

    local compact = viewport.Y < 380 or viewport.X < 420
    if compact then
        panel.Size = UDim2.new(1, -24, 1, -16)
        sizeConstraint.MinSize = Vector2.new(280, 220)
        header.Size = UDim2.new(1, 0, 0, 54)
        headerMask.Position = UDim2.new(0, 0, 1, -18)
        title.Position = UDim2.fromOffset(16, 5)
        title.Size = UDim2.new(1, -72, 0, 23)
        title.TextSize = 17
        subtitle.Position = UDim2.fromOffset(16, 29)
        subtitle.Size = UDim2.new(1, -72, 0, 16)
        subtitle.TextSize = 11
        closeButton.Position = UDim2.new(1, -8, 0.5, 0)
        closeButton.Size = UDim2.fromOffset(40, 40)
        body.Position = UDim2.fromOffset(0, 54)
        body.Size = UDim2.new(1, 0, 1, -112)
        body.ScrollBarThickness = 7
        footer.Size = UDim2.new(1, 0, 0, 58)
        leaveButton.Position = UDim2.fromOffset(10, 8)
        leaveButton.Size = UDim2.new(0.38, -5, 0, 42)
        primaryButton.Position = UDim2.fromOffset(10, 8)
        primaryButton.Size = UDim2.new(1, -20, 0, 42)
    else
        panel.Size = UDim2.new(0.92, 0, 0.82, 0)
        sizeConstraint.MinSize = Vector2.new(300, 310)
        header.Size = UDim2.new(1, 0, 0, 62)
        headerMask.Position = UDim2.new(0, 0, 1, -18)
        title.Position = UDim2.fromOffset(20, 8)
        title.Size = UDim2.new(1, -76, 0, 27)
        title.TextSize = 20
        subtitle.Position = UDim2.fromOffset(20, 34)
        subtitle.Size = UDim2.new(1, -76, 0, 18)
        subtitle.TextSize = 12
        closeButton.Position = UDim2.new(1, -14, 0.5, 0)
        closeButton.Size = UDim2.fromOffset(38, 38)
        body.Position = UDim2.fromOffset(0, 62)
        body.Size = UDim2.new(1, 0, 1, -128)
        body.ScrollBarThickness = 5
        footer.Size = UDim2.new(1, 0, 0, 66)
        leaveButton.Position = UDim2.fromOffset(14, 12)
        leaveButton.Size = UDim2.new(0.38, -7, 0, 42)
        primaryButton.Position = UDim2.fromOffset(14, 12)
        primaryButton.Size = UDim2.new(1, -28, 0, 42)
    end
end

local function bindViewport(camera)
    if viewportConnection then
        viewportConnection:Disconnect()
        viewportConnection = nil
    end
    if camera then
        viewportConnection = camera:GetPropertyChangedSignal("ViewportSize")
            :Connect(applyResponsiveLayout)
    end
    applyResponsiveLayout()
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    bindViewport(Workspace.CurrentCamera)
end)
bindViewport(Workspace.CurrentCamera)

local latestState = nil
local latestChoices = {}
local pendingRequest = nil
local primaryMode = "start"
local busy = false

local function setFeedback(text, positive)
    feedbackLabel.Text = text
    feedbackLabel.BackgroundColor3 = positive and COLORS.softGreen or COLORS.softGold
    feedbackLabel.TextColor3 = positive and COLORS.headerDark or COLORS.accentDark
end

local function setBusy(nextBusy)
    busy = nextBusy
    primaryButton.Active = not nextBusy
    leaveButton.Active = not nextBusy
    primaryButton.AutoButtonColor = not nextBusy
    leaveButton.AutoButtonColor = not nextBusy
    for _, button in ipairs(choiceButtons) do
        button.Active = not nextBusy
        button.AutoButtonColor = not nextBusy
    end
end

local function showPrimary(mode, text)
    primaryMode = mode
    primaryButton.Text = text
    primaryButton.Visible = true
end

local function renderState(state, feedback, feedbackPositive)
    if type(state) ~= "table" then
        return
    end
    latestState = state
    resultCard.Visible = false
    taskCard.Visible = true
    feedbackLabel.Visible = true

    if state.active == true and type(state.task) == "table" then
        local completedSteps = tonumber(state.completedSteps) or 0
        local totalSteps = tonumber(state.totalSteps) or 3
        progressLabel.Text = string.format(
            "ITEM %d OF %d  |  $%d SHIFT PAY",
            completedSteps + 1,
            totalSteps,
            tonumber(state.wage) or 0
        )
        itemLabel.Text = tostring(state.task.itemLabel or "Stock item")
        promptLabel.Text = tostring(state.task.prompt or "Choose the best aisle.")
        latestChoices = type(state.task.choices) == "table" and state.task.choices or {}
        choicesFrame.Visible = true
        for index, button in ipairs(choiceButtons) do
            local choice = latestChoices[index]
            button.Visible = type(choice) == "table"
            button.Text = choice and tostring(choice.label or "AISLE"):upper() or "AISLE"
        end
        leaveButton.Visible = true
        primaryButton.Visible = false
        setFeedback(
            feedback or "Pick the aisle that makes the most sense. You can retry any miss.",
            feedbackPositive ~= false
        )
    else
        progressLabel.Text = "READY FOR A 3-ITEM SHIFT"
        itemLabel.Text = "Ready to help?"
        promptLabel.Text = "Start a short shift and sort three items. Wrong answers only give a helpful hint."
        latestChoices = {}
        choicesFrame.Visible = false
        for _, button in ipairs(choiceButtons) do
            button.Visible = false
        end
        leaveButton.Visible = false
        showPrimary("start", "START 3-ITEM SHIFT")
        setFeedback(
            feedback or "Complete all three items to earn the listed shift pay.",
            feedbackPositive ~= false
        )
    end
end

local function renderResult(result)
    latestState = nil
    latestChoices = {}
    pendingRequest = nil
    taskCard.Visible = false
    choicesFrame.Visible = false
    feedbackLabel.Visible = false
    resultCard.Visible = true
    progressLabel.Text = "3 OF 3 ITEMS SORTED"
    resultTitle.Text = tostring(result.title or "Stock star!"):upper()
    resultMessage.Text = tostring(
        result.message or "You completed the stock shift."
    )
    rewardLabel.Text = string.format(
        "+$%d SHIFT PAY",
        tonumber(result.wage) or 0
    )
    if result.balance ~= nil then
        balanceLabel.Text = string.format("New balance: $%d", tonumber(result.balance) or 0)
    else
        balanceLabel.Text = "Shift pay saved"
    end
    leaveButton.Visible = false
    showPrimary("done", "DONE")
end

local function friendlyFailure(code)
    if code == "not_at_market" then
        return "Stay near the Market stock station to work this shift."
    elseif code == "stale_task" or code == "stale_shift" then
        return "The shift moved ahead. Your current item has been refreshed."
    elseif code == "request_conflict" then
        return "That tap was already used. Please choose the aisle again."
    elseif code == "economy_unavailable" or code == "wage_commit_failed" then
        return "Your work is still here. Try the final aisle again in a moment."
    elseif code == "no_active_shift" then
        return "That shift has ended. Start a fresh shift when you are ready."
    end
    return "The stock desk could not process that yet. Please try again."
end

local function applyResponse(response)
    if type(response) ~= "table" then
        setFeedback("The stock desk sent an unexpected response. Please try again.", false)
        return
    end
    if type(response.result) == "table" and response.accepted == true then
        renderResult(response.result)
        return
    end

    local feedback = response.feedback
    if type(feedback) ~= "string" or feedback == "" then
        feedback = response.accepted == true
            and "Shift updated."
            or friendlyFailure(response.code)
    end
    if type(response.state) == "table" then
        local feedbackPositive = response.accepted == true
            and response.code ~= "try_again"
        renderState(response.state, feedback, feedbackPositive)
    else
        setFeedback(feedback, response.accepted == true)
    end
end

local function refreshState()
    setBusy(true)
    local ok, state = pcall(function()
        return getStateRemote:InvokeServer()
    end)
    setBusy(false)
    if not ok or type(state) ~= "table" then
        setFeedback("Connection hiccup. Close and use the stock prompt to retry.", false)
        return
    end
    renderState(state)
end

local function startShift()
    if busy then
        return
    end
    setBusy(true)
    primaryButton.Text = "STARTING..."
    local ok, response = pcall(function()
        return startShiftRemote:InvokeServer()
    end)
    setBusy(false)
    if not ok then
        showPrimary("start", "TRY START AGAIN")
        setFeedback("Connection hiccup. Your shift did not start; please retry.", false)
        return
    end
    applyResponse(response)
end

local function submitChoice(choice)
    if busy
        or type(latestState) ~= "table"
        or latestState.active ~= true
        or type(latestState.task) ~= "table"
        or type(choice) ~= "table" then
        return
    end

    local shiftId = tostring(latestState.shiftId or "")
    local taskToken = tostring(latestState.task.token or "")
    local choiceId = tostring(choice.id or "")
    local signature = shiftId .. "|" .. taskToken .. "|" .. choiceId
    if not pendingRequest or pendingRequest.signature ~= signature then
        pendingRequest = {
            signature = signature,
            requestId = "market:" .. HttpService:GenerateGUID(false),
        }
    end

    setBusy(true)
    setFeedback("Checking that aisle...", true)
    local requestId = pendingRequest.requestId
    local ok, response = pcall(function()
        return submitSortRemote:InvokeServer(
            shiftId,
            taskToken,
            choiceId,
            requestId
        )
    end)
    setBusy(false)
    if not ok then
        setFeedback("Connection hiccup. Tap the same aisle to safely retry.", false)
        return
    end

    local transient = type(response) == "table"
        and (response.code == "economy_unavailable" or response.code == "wage_commit_failed")
    if not transient then
        pendingRequest = nil
    end
    applyResponse(response)
end

local function leaveShift()
    if busy then
        return
    end
    setBusy(true)
    leaveButton.Text = "LEAVING..."
    local ok, response = pcall(function()
        return leaveShiftRemote:InvokeServer()
    end)
    leaveButton.Text = "LEAVE SHIFT"
    setBusy(false)
    if not ok then
        setFeedback("Connection hiccup. Your shift is still available to continue.", false)
        return
    end
    pendingRequest = nil
    applyResponse(response)
end

for index, button in ipairs(choiceButtons) do
    button.Activated:Connect(function()
        submitChoice(latestChoices[index])
    end)
end

primaryButton.Activated:Connect(function()
    if primaryMode == "done" then
        overlay.Visible = false
    else
        startShift()
    end
end)

leaveButton.Activated:Connect(leaveShift)

closeButton.Activated:Connect(function()
    overlay.Visible = false
end)

openPanelRemote.OnClientEvent:Connect(function()
    overlay.Visible = true
    resultCard.Visible = false
    feedbackLabel.Visible = true
    setFeedback("Opening the stock desk...", true)
    refreshState()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="53">
        <Properties>
          <string name="Name">PEDodgeballDrill</string>
          <string name="Source"><![CDATA[--!strict
-- Movement-safe HUD for the server-authoritative P.E. dodgeball drill.
-- It displays public timer/hit state and provides only a safe leave action.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local remoteRoot = ReplicatedStorage:WaitForChild("SchoolFoundation")
local drillRoot = remoteRoot:WaitForChild("FreeRoam"):WaitForChild("PEDodgeballDrill")
local getStateRemote = drillRoot:WaitForChild("GetState")
local leaveRemote = drillRoot:WaitForChild("Leave")
local sessionStartedRemote = drillRoot:WaitForChild("SessionStarted")
local stateUpdatedRemote = drillRoot:WaitForChild("StateUpdated")
local sessionEndedRemote = drillRoot:WaitForChild("SessionEnded")

local COLORS = {
    navy = Color3.fromRGB(34, 62, 103),
    blue = Color3.fromRGB(61, 112, 171),
    paleBlue = Color3.fromRGB(221, 235, 249),
    coral = Color3.fromRGB(238, 102, 89),
    gold = Color3.fromRGB(243, 184, 66),
    ink = Color3.fromRGB(35, 47, 61),
    muted = Color3.fromRGB(91, 103, 116),
    white = Color3.fromRGB(255, 255, 255),
    card = Color3.fromRGB(249, 250, 247),
    line = Color3.fromRGB(199, 210, 219),
    overlay = Color3.fromRGB(15, 24, 36),
}

local function addCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = parent
    return corner
end

local function addStroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness
    stroke.Transparency = transparency or 0
    stroke.Parent = parent
    return stroke
end

local function styleButton(button, background, foreground)
    button.AutoButtonColor = true
    button.BackgroundColor3 = background
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamBold
    button.TextColor3 = foreground
    button.TextSize = 14
    addCorner(button, 9)
end

local gui = Instance.new("ScreenGui")
gui.Name = "PEDodgeballDrillGui"
gui.DisplayOrder = 45
gui.IgnoreGuiInset = false
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local activePanel = Instance.new("Frame")
activePanel.Name = "ActiveDrillHud"
activePanel.AnchorPoint = Vector2.new(0.5, 0)
activePanel.BackgroundColor3 = COLORS.card
activePanel.BorderSizePixel = 0
activePanel.Position = UDim2.new(0.5, 0, 0, 14)
activePanel.Size = UDim2.new(0.92, 0, 0, 142)
activePanel.Visible = false
activePanel.Parent = gui
addCorner(activePanel, 16)
addStroke(activePanel, COLORS.navy, 2, 0.2)

local activeConstraint = Instance.new("UISizeConstraint")
activeConstraint.MinSize = Vector2.new(280, 142)
activeConstraint.MaxSize = Vector2.new(520, 142)
activeConstraint.Parent = activePanel

local activeHeader = Instance.new("Frame")
activeHeader.BackgroundColor3 = COLORS.blue
activeHeader.BorderSizePixel = 0
activeHeader.Size = UDim2.new(1, 0, 0, 42)
activeHeader.Parent = activePanel
addCorner(activeHeader, 16)

local activeHeaderMask = Instance.new("Frame")
activeHeaderMask.BackgroundColor3 = COLORS.blue
activeHeaderMask.BorderSizePixel = 0
activeHeaderMask.Position = UDim2.new(0, 0, 1, -16)
activeHeaderMask.Size = UDim2.new(1, 0, 0, 16)
activeHeaderMask.Parent = activeHeader

local activeTitle = Instance.new("TextLabel")
activeTitle.BackgroundTransparency = 1
activeTitle.Position = UDim2.fromOffset(14, 0)
activeTitle.Size = UDim2.new(1, -130, 1, 0)
activeTitle.Font = Enum.Font.GothamBold
activeTitle.Text = "P.E. DODGEBALL"
activeTitle.TextColor3 = COLORS.white
activeTitle.TextSize = 17
activeTitle.TextXAlignment = Enum.TextXAlignment.Left
activeTitle.Parent = activeHeader

local timerLabel = Instance.new("TextLabel")
timerLabel.AnchorPoint = Vector2.new(1, 0.5)
timerLabel.BackgroundColor3 = COLORS.navy
timerLabel.BorderSizePixel = 0
timerLabel.Position = UDim2.new(1, -10, 0.5, 0)
timerLabel.Size = UDim2.fromOffset(98, 30)
timerLabel.Font = Enum.Font.GothamBold
timerLabel.Text = "15.0s"
timerLabel.TextColor3 = COLORS.white
timerLabel.TextSize = 18
timerLabel.Parent = activeHeader
addCorner(timerLabel, 8)

local instructionLabel = Instance.new("TextLabel")
instructionLabel.BackgroundTransparency = 1
instructionLabel.Position = UDim2.fromOffset(14, 49)
instructionLabel.Size = UDim2.new(1, -126, 0, 28)
instructionLabel.Font = Enum.Font.GothamBold
instructionLabel.Text = "MOVE NORMALLY - DODGE THE FOAM BALLS!"
instructionLabel.TextColor3 = COLORS.ink
instructionLabel.TextSize = 13
instructionLabel.TextWrapped = true
instructionLabel.TextXAlignment = Enum.TextXAlignment.Left
instructionLabel.Parent = activePanel

local statsLabel = Instance.new("TextLabel")
statsLabel.BackgroundTransparency = 1
statsLabel.Position = UDim2.fromOffset(14, 78)
statsLabel.Size = UDim2.new(1, -126, 0, 22)
statsLabel.Font = Enum.Font.Gotham
statsLabel.Text = "Hits: 0   |   Balls: 0 / 11"
statsLabel.TextColor3 = COLORS.muted
statsLabel.TextSize = 13
statsLabel.TextXAlignment = Enum.TextXAlignment.Left
statsLabel.Parent = activePanel

local progressTrack = Instance.new("Frame")
progressTrack.BackgroundColor3 = COLORS.paleBlue
progressTrack.BorderSizePixel = 0
progressTrack.Position = UDim2.fromOffset(14, 111)
progressTrack.Size = UDim2.new(1, -126, 0, 12)
progressTrack.Parent = activePanel
addCorner(progressTrack, 6)

local progressFill = Instance.new("Frame")
progressFill.BackgroundColor3 = COLORS.gold
progressFill.BorderSizePixel = 0
progressFill.Size = UDim2.fromScale(0, 1)
progressFill.Parent = progressTrack
addCorner(progressFill, 6)

local leaveButton = Instance.new("TextButton")
leaveButton.Name = "LeaveDrill"
leaveButton.AnchorPoint = Vector2.new(1, 1)
leaveButton.Position = UDim2.new(1, -12, 1, -13)
leaveButton.Size = UDim2.fromOffset(100, 40)
leaveButton.Text = "LEAVE"
leaveButton.Parent = activePanel
styleButton(leaveButton, COLORS.coral, COLORS.white)

local resultOverlay = Instance.new("Frame")
resultOverlay.Name = "ResultOverlay"
resultOverlay.BackgroundColor3 = COLORS.overlay
resultOverlay.BackgroundTransparency = 0.28
resultOverlay.BorderSizePixel = 0
resultOverlay.Size = UDim2.fromScale(1, 1)
resultOverlay.Visible = false
resultOverlay.Parent = gui

local resultCard = Instance.new("Frame")
resultCard.Name = "DodgeballResultCard"
resultCard.AnchorPoint = Vector2.new(0.5, 0.5)
resultCard.BackgroundColor3 = COLORS.card
resultCard.BorderSizePixel = 0
resultCard.Position = UDim2.fromScale(0.5, 0.5)
resultCard.Size = UDim2.new(0.9, 0, 0.7, 0)
resultCard.Parent = resultOverlay
addCorner(resultCard, 18)
addStroke(resultCard, COLORS.navy, 2, 0.25)

local resultConstraint = Instance.new("UISizeConstraint")
resultConstraint.MinSize = Vector2.new(280, 290)
resultConstraint.MaxSize = Vector2.new(500, 410)
resultConstraint.Parent = resultCard

local resultHeader = Instance.new("TextLabel")
resultHeader.BackgroundColor3 = COLORS.blue
resultHeader.BorderSizePixel = 0
resultHeader.Size = UDim2.new(1, 0, 0, 56)
resultHeader.Font = Enum.Font.GothamBold
resultHeader.Text = "DRILL COMPLETE!"
resultHeader.TextColor3 = COLORS.white
resultHeader.TextSize = 21
resultHeader.Parent = resultCard
addCorner(resultHeader, 18)

local resultHeaderMask = Instance.new("Frame")
resultHeaderMask.BackgroundColor3 = COLORS.blue
resultHeaderMask.BorderSizePixel = 0
resultHeaderMask.Position = UDim2.new(0, 0, 1, -18)
resultHeaderMask.Size = UDim2.new(1, 0, 0, 18)
resultHeaderMask.Parent = resultHeader

local gradeBadge = Instance.new("TextLabel")
gradeBadge.AnchorPoint = Vector2.new(0.5, 0)
gradeBadge.BackgroundColor3 = COLORS.gold
gradeBadge.BorderSizePixel = 0
gradeBadge.Position = UDim2.new(0.5, 0, 0, 66)
gradeBadge.Size = UDim2.fromOffset(100, 64)
gradeBadge.Font = Enum.Font.GothamBold
gradeBadge.Text = "A+"
gradeBadge.TextColor3 = COLORS.navy
gradeBadge.TextSize = 38
gradeBadge.Parent = resultCard
addCorner(gradeBadge, 18)

local resultStats = Instance.new("TextLabel")
resultStats.BackgroundTransparency = 1
resultStats.Position = UDim2.new(0, 18, 0, 140)
resultStats.Size = UDim2.new(1, -36, 0, 24)
resultStats.Font = Enum.Font.GothamBold
resultStats.Text = "10 dodged  |  1 foam hit"
resultStats.TextColor3 = COLORS.ink
resultStats.TextSize = 16
resultStats.Parent = resultCard

local resultMessage = Instance.new("TextLabel")
resultMessage.BackgroundTransparency = 1
resultMessage.Position = UDim2.new(0, 24, 0, 172)
resultMessage.Size = UDim2.new(1, -48, 1, -238)
resultMessage.Font = Enum.Font.Gotham
resultMessage.Text = "Great movement! One tap could not slow you down."
resultMessage.TextColor3 = COLORS.muted
resultMessage.TextSize = 14
resultMessage.TextWrapped = true
resultMessage.TextYAlignment = Enum.TextYAlignment.Top
resultMessage.Parent = resultCard

local doneButton = Instance.new("TextButton")
doneButton.Name = "Done"
doneButton.AnchorPoint = Vector2.new(0.5, 1)
doneButton.Position = UDim2.new(0.5, 0, 1, -16)
doneButton.Size = UDim2.new(1, -36, 0, 44)
doneButton.Text = "DONE"
doneButton.Parent = resultCard
styleButton(doneButton, COLORS.gold, COLORS.navy)

local busy = false
local lastHits = 0

local function renderActiveState(state)
    if type(state) ~= "table" or state.active ~= true then
        activePanel.Visible = false
        return
    end
    resultOverlay.Visible = false
    activePanel.Visible = true

    local remaining = math.max(0, tonumber(state.remainingSeconds) or 0)
    local duration = math.max(0.01, tonumber(state.duration) or 15)
    local hits = math.max(0, math.floor(tonumber(state.hits) or 0))
    local thrown = math.max(0, math.floor(tonumber(state.ballsThrown) or 0))
    local total = math.max(1, math.floor(tonumber(state.totalBalls) or 1))
    timerLabel.Text = string.format("%.1fs", remaining)
    statsLabel.Text = string.format("Hits: %d   |   Balls: %d / %d", hits, thrown, total)
    progressFill.Size = UDim2.fromScale(
        math.clamp(1 - remaining / duration, 0, 1),
        1
    )
    if hits > lastHits then
        instructionLabel.Text = "FOAM TAP - KEEP MOVING, YOU'VE GOT THIS!"
        instructionLabel.TextColor3 = COLORS.coral
    else
        instructionLabel.Text = "MOVE NORMALLY - DODGE THE FOAM BALLS!"
        instructionLabel.TextColor3 = COLORS.ink
    end
    lastHits = hits
end

local function renderResult(result)
    if type(result) ~= "table" then
        return
    end
    activePanel.Visible = false
    resultOverlay.Visible = true
    local completed = result.completed == true
    resultHeader.Text = tostring(
        result.title or (completed and "Drill complete!" or "Drill ended safely")
    ):upper()
    gradeBadge.Text = completed and tostring(result.grade or "C") or "SAFE"
    gradeBadge.BackgroundColor3 = completed and COLORS.gold or COLORS.paleBlue

    local hits = math.max(0, math.floor(tonumber(result.hits) or 0))
    local dodged = math.max(0, math.floor(tonumber(result.dodged) or 0))
    if completed then
        resultStats.Text = string.format(
            "%d dodged  |  %d foam hit%s",
            dodged,
            hits,
            hits == 1 and "" or "s"
        )
    else
        resultStats.Text = "No penalty - normal movement restored"
    end
    resultMessage.Text = tostring(
        result.message
            or "Return to the gym prompt whenever you want another try."
    )
    lastHits = 0
end

local function renderNotice(titleText, messageText)
    renderResult({
        completed = false,
        title = titleText,
        message = messageText,
        hits = 0,
        dodged = 0,
    })
end

leaveButton.Activated:Connect(function()
    if busy then
        return
    end
    busy = true
    leaveButton.Active = false
    leaveButton.Text = "LEAVING..."
    local ok, outcome = pcall(function()
        return leaveRemote:InvokeServer()
    end)
    busy = false
    leaveButton.Active = true
    leaveButton.Text = "LEAVE"
    if not ok or type(outcome) ~= "table" then
        instructionLabel.Text = "COULDN'T LEAVE YET - KEEP MOVING AND RETRY"
        instructionLabel.TextColor3 = COLORS.coral
        return
    end
    if type(outcome.result) == "table" then
        renderResult(outcome.result)
    else
        activePanel.Visible = false
    end
end)

doneButton.Activated:Connect(function()
    resultOverlay.Visible = false
end)

sessionStartedRemote.OnClientEvent:Connect(function(payload)
    if type(payload) ~= "table" then
        return
    end
    if type(payload.state) == "table" and payload.state.active == true then
        lastHits = tonumber(payload.state.hits) or 0
        renderActiveState(payload.state)
    elseif payload.code == "start_rate_limited" then
        renderNotice(
            "Ready in a moment",
            "The prior prompt tap is still clearing. Use it again right away."
        )
    elseif payload.code ~= "session_already_active" then
        renderNotice(
            "Drill unavailable",
            "Stand near the gym drill station and try again."
        )
    end
end)

stateUpdatedRemote.OnClientEvent:Connect(function(state)
    renderActiveState(state)
end)

sessionEndedRemote.OnClientEvent:Connect(function(payload)
    if type(payload) == "table" then
        renderResult(payload.result)
    end
end)

task.defer(function()
    local ok, state = pcall(function()
        return getStateRemote:InvokeServer()
    end)
    if ok and type(state) == "table" and state.active == true then
        lastHits = tonumber(state.hits) or 0
        renderActiveState(state)
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="54">
        <Properties>
          <string name="Name">StyleShopCatalog</string>
          <string name="Source"><![CDATA[--!strict
-- Polished catalog surface that augments the canonical STYLE SHOP panel.
-- Price, ownership, purchase, and equip authority stay on the server.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local shopRemotes = ReplicatedStorage:WaitForChild("SchoolFoundation")
    :WaitForChild("FreeRoam")
    :WaitForChild("StyleShop")
local getState = shopRemotes:WaitForChild("GetState")
local purchaseItem = shopRemotes:WaitForChild("PurchaseItem")
local equipItem = shopRemotes:WaitForChild("EquipItem")

local screenGui = playerGui:WaitForChild("RobloxHighSchoolLegacyUI", 30)
if screenGui == nil then return end
local panel = screenGui:WaitForChild("FeaturePanel_shop", 30)
if panel == nil then return end
local body = panel:WaitForChild("Body", 10)
if body == nil or body:GetAttribute("StyleCatalogMounted") == true then return end

body:SetAttribute("StyleCatalogMounted", true)
body:ClearAllChildren()
body.ClipsDescendants = true

local BLUE_DARK = Color3.fromRGB(35, 67, 98)
local BLUE = Color3.fromRGB(55, 126, 168)
local PAPER = Color3.fromRGB(245, 250, 253)
local GREEN = Color3.fromRGB(74, 164, 104)
local GOLD = Color3.fromRGB(229, 168, 50)
local MUTED = Color3.fromRGB(103, 126, 145)

local function rounded(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = instance
end

local function stroke(instance, color, thickness)
    local line = Instance.new("UIStroke")
    line.Color = color
    line.Thickness = thickness or 1
    line.Transparency = 0.12
    line.Parent = instance
    return line
end

local function rgb(value, fallback)
    if type(value) ~= "table" or #value < 3 then return fallback end
    return Color3.fromRGB(value[1], value[2], value[3])
end

