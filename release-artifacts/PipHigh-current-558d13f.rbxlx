      <Item class="LocalScript" referent="50">
        <Properties>
          <string name="Name">CanonicalSchoolClient</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
