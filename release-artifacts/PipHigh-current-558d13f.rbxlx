spawn.Parent = campus

makeLabel("PIP HIGH", CFrame.new(0, 12, 119.5) * CFrame.Angles(0, math.rad(180), 0))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ClassActivityCatalog</string>
          <string name="Source"><![CDATA[--!strict
-- Server-only class activity catalog. Answer keys never enter ReplicatedStorage.
-- Activities are grouped in schedule order, then by increasing difficulty.

return {
    -- Math: short arithmetic and algebra rounds reward accuracy before speed.
    {
        id = "math-linear-1",
        subject = "Math",
        difficulty = 1,
        prompt = "A number plus 6 equals 15. Which number makes the equation true?",
        choices = { "8", "9", "10", "21" },
        correctIndex = 2,
        hint = "Undo adding 6 by subtracting 6 from 15.",
        explanation = "The number is 9 because 9 + 6 = 15.",
    },
    {
        id = "math-supplies-2",
        subject = "Math",
        difficulty = 2,
        prompt = "A supply cart has 24 markers and receives 17 more. How many markers are on the cart now?",
        choices = { "39", "40", "41", "42" },
        correctIndex = 3,
        hint = "Add the tens and ones, regrouping the 11 ones.",
        explanation = "24 + 17 = 41 after regrouping 11 ones as 1 ten and 1 one.",
    },
    {
        id = "math-groups-3",
        subject = "Math",
        difficulty = 3,
        prompt = "Solve 4 x (7 - 2).",
        choices = { "12", "18", "20", "28" },
        correctIndex = 3,
        hint = "Evaluate the parentheses before multiplying.",
        explanation = "7 - 2 is 5, and 4 x 5 is 20.",
    },
    {
        id = "math-brushes-4",
        subject = "Math",
        difficulty = 4,
        prompt = "Three art tables each need 7 brushes, and 5 extra brushes stay in the cabinet. How many brushes are there altogether?",
        choices = { "21", "24", "26", "36" },
        correctIndex = 3,
        hint = "Find 3 groups of 7, then include the 5 extras.",
        explanation = "Three groups of 7 make 21; adding 5 gives 26 brushes.",
    },
    {
        id = "math-equation-5",
        subject = "Math",
        difficulty = 5,
        prompt = "Solve 5n - 8 = 37.",
        choices = { "5", "8", "9", "29" },
        correctIndex = 3,
        hint = "Add 8 to both sides, then divide by 5.",
        explanation = "Adding 8 gives 5n = 45, so n = 9.",
    },

    -- Art: text-encoded canvases exercise the same visual matching skills as a tile grid.
    {
        id = "art-stripe-1",
        subject = "Art",
        difficulty = 1,
        prompt = "The target stripe is coral, mint, coral. Which palette sequence matches it exactly?",
        choices = {
            "coral / coral / mint",
            "mint / coral / mint",
            "coral / mint / coral",
            "mint / mint / coral",
        },
        correctIndex = 3,
        hint = "Compare each position from left to right.",
        explanation = "Coral, mint, coral matches all three target positions.",
    },
    {
        id = "art-center-tile-2",
        subject = "Art",
        difficulty = 2,
        prompt = "A 3 by 3 tile design has rows AAB, ABB, AAB. Which color belongs in the center tile?",
        choices = { "Color A", "Color B", "Border color", "No color" },
        correctIndex = 2,
        hint = "The center is the second symbol in the second row.",
        explanation = "The second row is ABB, so its center tile is Color B.",
    },
    {
        id = "art-mirror-row-3",
        subject = "Art",
        difficulty = 3,
        prompt = "Complete the mirrored color row: violet, gold, blank, violet.",
        choices = { "Mint", "Gold", "Violet", "Coral" },
        correctIndex = 2,
        hint = "In a mirror row, the two inner tiles match each other.",
        explanation = "Gold completes the symmetric row: violet, gold, gold, violet.",
    },
    {
        id = "art-grid-count-4",
        subject = "Art",
        difficulty = 4,
        prompt = "A 4 by 4 grid has rows TTSS, TSST, SSTT, TSTS. How many tiles use color T?",
        choices = { "6 tiles", "7 tiles", "8 tiles", "9 tiles" },
        correctIndex = 3,
        hint = "Count the T tiles in each row, then add the four row totals.",
        explanation = "Each row contains two T tiles, for 8 T tiles altogether.",
    },
    {
        id = "art-diagonal-copy-5",
        subject = "Art",
        difficulty = 5,
        prompt = "The target canvas rows are SUN-SKY-SKY, SKY-SUN-SKY, SKY-SKY-SUN. Which copy is exact?",
        choices = {
            "SUN-SKY-SKY | SKY-SKY-SUN | SKY-SUN-SKY",
            "SKY-SUN-SKY | SUN-SKY-SKY | SKY-SKY-SUN",
            "SUN-SKY-SKY | SKY-SUN-SKY | SKY-SKY-SUN",
            "SUN-SUN-SKY | SKY-SUN-SKY | SKY-SKY-SUN",
        },
        correctIndex = 3,
        hint = "Track the SUN tile as it moves one column right in each row.",
        explanation = "The exact copy places SUN at column 1, then 2, then 3.",
    },

    -- PE: dodgeball scenarios teach awareness, teamwork, scoring, and timing.
    {
        id = "pe-dodge-1",
        subject = "PE",
        difficulty = 1,
        prompt = "A foam ball is approaching from the front. Which move best keeps you ready to play?",
        choices = {
            "Step sideways while watching the ball",
            "Turn around and stop moving",
            "Close your eyes and wait",
            "Run toward the nearest wall without looking",
        },
        correctIndex = 1,
        hint = "Keep the ball in view while moving out of its path.",
        explanation = "A controlled sideways step avoids the throw while preserving awareness.",
    },
    {
        id = "pe-team-pass-2",
        subject = "PE",
        difficulty = 2,
        prompt = "You recover a ball while a nearby teammate is open and facing you. What is the strongest team play?",
        choices = {
            "Hide the ball until time expires",
            "Pass to the open teammate and spread out",
            "Throw straight up without warning",
            "Stand beside the teammate with the ball",
        },
        correctIndex = 2,
        hint = "A safe pass can create more than one attacking angle.",
        explanation = "Passing and spreading out gives the team two useful positions.",
    },
    {
        id = "pe-score-total-3",
        subject = "PE",
        difficulty = 3,
        prompt = "A round awards 1 point for a hit and 3 points for a knockout. What is the total for two hits and one knockout?",
        choices = { "4 points", "5 points", "6 points", "7 points" },
        correctIndex = 2,
        hint = "Add 1 + 1 + 3.",
        explanation = "Two hits give 2 points and the knockout gives 3, totaling 5.",
    },
    {
        id = "pe-shield-timing-4",
        subject = "PE",
        difficulty = 4,
        prompt = "A shield lasts only a few seconds and an opponent has just begun a throw. When should you activate it?",
        choices = {
            "Before the round begins",
            "Just before the incoming ball reaches you",
            "After the ball has passed",
            "Only while your team holds every ball",
        },
        correctIndex = 2,
        hint = "Use a short effect when it can cover the moment of impact.",
        explanation = "Activating shortly before impact uses the limited shield time effectively.",
    },
    {
        id = "pe-angles-5",
        subject = "PE",
        difficulty = 5,
        prompt = "Your team has two balls and two throwers. Which formation makes both throws hardest to track?",
        choices = {
            "Both throwers stand in the same corner",
            "One thrower kneels directly behind the other",
            "The throwers separate and attack from different angles",
            "Both throwers face away from the court",
        },
        correctIndex = 3,
        hint = "A defender has more to watch when threats come from separated positions.",
        explanation = "Separated throwers create two angles and divide the defender's attention.",
    },

    -- Science & Engineering: a scored salvage hunt mixes observation and applied science.
    {
        id = "scienceengineering-scrap-score-1",
        subject = "ScienceEngineering",
        difficulty = 1,
        prompt = "In a scrap hunt, a washer is worth 3, a bolt 6, and a panel 12. What is one of each worth?",
        choices = { "18 points", "20 points", "21 points", "24 points" },
        correctIndex = 3,
        hint = "Add the three part values: 3 + 6 + 12.",
        explanation = "The three parts are worth 21 points in total.",
    },
    {
        id = "scienceengineering-magnet-2",
        subject = "ScienceEngineering",
        difficulty = 2,
        prompt = "Which loose part would a basic magnet pull most strongly?",
        choices = { "Iron bracket", "Rubber ring", "Plastic chip", "Wooden peg" },
        correctIndex = 1,
        hint = "Look for a ferromagnetic material.",
        explanation = "Iron is strongly attracted to a basic magnet.",
    },
    {
        id = "scienceengineering-conductor-3",
        subject = "ScienceEngineering",
        difficulty = 3,
        prompt = "A repair station needs a part that conducts electricity. Which scrap item is the best choice?",
        choices = { "Glass tube", "Copper wire", "Foam block", "Ceramic tile" },
        correctIndex = 2,
        hint = "Metals commonly allow electric charge to move through them.",
        explanation = "Copper wire is a strong electrical conductor.",
    },
    {
        id = "scienceengineering-route-4",
        subject = "ScienceEngineering",
        difficulty = 4,
        prompt = "Eight seconds remain. Route A earns 18 points in 6 seconds, B earns 22 in 11, C earns 15 in 4, and D earns 25 in 15. Which route earns the most before time expires?",
        choices = { "Route A", "Route B", "Route C", "Route D" },
        correctIndex = 1,
        hint = "Eliminate routes that take longer than 8 seconds, then compare the remaining scores.",
        explanation = "Routes A and C fit the timer, and Route A earns the higher score.",
    },
    {
        id = "scienceengineering-hot-metal-5",
        subject = "ScienceEngineering",
        difficulty = 5,
        prompt = "A sensor marks one scrap part as dangerously hot. What should the collection team do?",
        choices = {
            "Skip it and report the hazard",
            "Carry it with bare hands",
            "Hide it under other parts",
            "Cool it by placing it beside paper",
        },
        correctIndex = 1,
        hint = "A safe plan avoids direct contact and alerts others.",
        explanation = "Skipping and reporting the hot part prevents burns and protects the team.",
    },

    -- Performance Arts: cue recall grows from exact repetition to working-memory rules.
    {
        id = "performancearts-repeat-1",
        subject = "PerformanceArts",
        difficulty = 1,
        prompt = "The stage cues flash clap, turn, clap. Which response repeats them exactly?",
        choices = {
            "clap / turn / clap",
            "turn / clap / turn",
            "clap / clap / turn",
            "turn / turn / clap",
        },
        correctIndex = 1,
        hint = "Compare the response with the cue one position at a time.",
        explanation = "Clap, turn, clap preserves the complete order.",
    },
    {
        id = "performancearts-growing-pattern-2",
        subject = "PerformanceArts",
        difficulty = 2,
        prompt = "A routine grows as clap-turn, then clap-turn-stomp. Which sequence should come next?",
        choices = {
            "clap-turn-jump-stomp",
            "turn-stomp-jump-clap",
            "clap-turn-stomp-jump",
            "stomp-clap-turn-jump",
        },
        correctIndex = 3,
        hint = "Keep the existing routine in order and add one cue at the end.",
        explanation = "Clap-turn-stomp-jump extends the previous routine by one cue.",
    },
    {
        id = "performancearts-reverse-3",
        subject = "PerformanceArts",
        difficulty = 3,
        prompt = "The director calls step, bow, spin, clap. Which sequence performs those cues in reverse?",
        choices = {
            "clap-spin-bow-step",
            "spin-clap-step-bow",
            "step-bow-spin-clap",
            "bow-step-clap-spin",
        },
        correctIndex = 1,
        hint = "Start with the final cue and work backward.",
        explanation = "Reversing the four cues gives clap, spin, bow, step.",
    },
    {
        id = "performancearts-cycle-4",
        subject = "PerformanceArts",
        difficulty = 4,
        prompt = "A three-cue cycle is left, spin, clap. The stage shows left, spin, clap, left, spin. Which cue comes next?",
        choices = { "Bow", "Clap", "Jump", "Right" },
        correctIndex = 2,
        hint = "The same three cues repeat in order.",
        explanation = "After left and spin, clap completes the next cycle.",
    },
    {
        id = "performancearts-repeat-detection-5",
        subject = "PerformanceArts",
        difficulty = 5,
        prompt = "The lights flash teal, gold, teal, violet, gold. Respond only when a color has appeared earlier. On which cue numbers should you respond?",
        choices = { "1 and 2", "2 and 4", "3 and 5", "4 and 5" },
        correctIndex = 3,
        hint = "Track the first appearance of each color, then mark later repeats.",
        explanation = "Teal repeats on cue 3 and gold repeats on cue 5.",
    },

    -- Cooking: recipe selection, sequencing, scaling, and timer management.
    {
        id = "cooking-fruit-cup-1",
        subject = "Cooking",
        difficulty = 1,
        prompt = "The fruit cup recipe needs apple, berry, and mint. Which tray has exactly those ingredients?",
        choices = {
            "apple, berry, mint",
            "apple, berry, rice",
            "apple, lemon, mint",
            "bean, berry, mint",
        },
        correctIndex = 1,
        hint = "Check that all three requested ingredients are present and no substitute was added.",
        explanation = "Apple, berry, and mint is the exact recipe.",
    },
    {
        id = "cooking-next-step-2",
        subject = "Cooking",
        difficulty = 2,
        prompt = "A soup method says wash, chop, simmer, serve. The vegetables have just been chopped. What comes next?",
        choices = { "Serve immediately", "Wash again", "Simmer the ingredients", "Return everything to storage" },
        correctIndex = 3,
        hint = "Follow the method in the order it is written.",
        explanation = "Simmer follows chopping and comes before serving.",
    },
    {
        id = "cooking-scale-recipe-3",
        subject = "Cooking",
        difficulty = 3,
        prompt = "One stew bowl needs 2 carrots and 1 bean scoop. What is needed for two bowls?",
        choices = {
            "2 carrots and 2 bean scoops",
            "3 carrots and 1 bean scoop",
            "4 carrots and 1 bean scoop",
            "4 carrots and 2 bean scoops",
        },
        correctIndex = 4,
        hint = "Double every ingredient, not just one of them.",
        explanation = "Two bowls need twice the recipe: 4 carrots and 2 bean scoops.",
    },
    {
        id = "cooking-finish-recipe-4",
        subject = "Cooking",
        difficulty = 4,
        prompt = "A rice bowl needs herb, rice, and lemon. Herb and rice are already in the pot. Which action completes it safely?",
        choices = {
            "Add the fresh lemon",
            "Add a spoiled berry",
            "Remove the rice and add sugar",
            "Serve before adding the last ingredient",
        },
        correctIndex = 1,
        hint = "Use the one fresh ingredient still missing from the recipe.",
        explanation = "Fresh lemon is the remaining required ingredient.",
    },
    {
        id = "cooking-timer-plan-5",
        subject = "Cooking",
        difficulty = 5,
        prompt = "Soup expires in 8 seconds and needs one 4-second step. A tart expires in 20 seconds and needs three 5-second steps. Which plan finishes both on time?",
        choices = {
            "Complete the soup, then complete the tart",
            "Complete all tart steps, then start the soup",
            "Wait 8 seconds, then begin either dish",
            "Alternate after every second without completing a step",
        },
        correctIndex = 1,
        hint = "Finish the shortest deadline first, then check the total time against the other deadline.",
        explanation = "The soup finishes at 4 seconds and the tart at 19 seconds, before both deadlines.",
    },

    -- Dance: lane reading and beat arithmetic without using protected songs or choreography.
    {
        id = "dance-lane-1",
        subject = "Dance",
        difficulty = 1,
        prompt = "A note reaches the LEFT lane exactly on the beat. Which input should you make?",
        choices = { "Press LEFT", "Press RIGHT", "Press UP", "Press nothing" },
        correctIndex = 1,
        hint = "Match the input to the lane containing the note.",
        explanation = "Pressing LEFT on the beat matches the LEFT-lane note.",
    },
    {
        id = "dance-lane-sequence-2",
        subject = "Dance",
        difficulty = 2,
        prompt = "The lane pattern is LEFT, UP, RIGHT, DOWN. Which input sequence matches it?",
        choices = {
            "LEFT-UP-RIGHT-DOWN",
            "LEFT-RIGHT-UP-DOWN",
            "DOWN-RIGHT-UP-LEFT",
            "UP-LEFT-DOWN-RIGHT",
        },
        correctIndex = 1,
        hint = "Read and preserve the four lanes from first to last.",
        explanation = "LEFT-UP-RIGHT-DOWN exactly matches the displayed lane order.",
    },
    {
        id = "dance-combo-3",
        subject = "Dance",
        difficulty = 3,
        prompt = "A combo multiplier starts at 1x and rises by 1 after every 4 clean hits. What multiplier follows 8 clean hits?",
        choices = { "1x multiplier", "2x multiplier", "3x multiplier", "4x multiplier" },
        correctIndex = 3,
        hint = "Eight clean hits contain two complete groups of four.",
        explanation = "Two increases move the multiplier from 1x to 3x.",
    },
    {
        id = "dance-rest-4",
        subject = "Dance",
        difficulty = 4,
        prompt = "A four-beat chart reads HIT, HIT, REST, HIT. What should happen on beat 3?",
        choices = {
            "Press two lanes",
            "Hold the previous lane",
            "Make no input",
            "Press every lane once",
        },
        correctIndex = 3,
        hint = "A rest reserves the beat for silence and stillness.",
        explanation = "No input on beat 3 correctly performs the rest.",
    },
    {
        id = "dance-score-5",
        subject = "Dance",
        difficulty = 5,
        prompt = "A clean hit earns 100 times the multiplier. You hit once at 3x, miss and reset to 1x, then hit once at 1x. How many points do the two hits earn?",
        choices = { "300 points", "350 points", "400 points", "600 points" },
        correctIndex = 3,
        hint = "Score the first and second hits separately, then add them.",
        explanation = "The hits earn 300 and 100 points, totaling 400.",
    },
}
]]></string>
