      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">StyleShopController</string>
          <string name="Source"><![CDATA[--!strict
-- Server-authoritative cash purchase and ownership boundary for the Style Shop.

local Controller = {}
Controller.__index = Controller

local MAX_REQUEST_ID_LENGTH = 64
local OWNERSHIP_CATEGORY = "style"

local function isInteger(value)
    return type(value) == "number" and value == math.floor(value)
end

local function validIdentifier(value, maximumLength)
    return type(value) == "string"
        and #value > 0
        and #value <= maximumLength
        and value:match("^[%w_%-]+$") ~= nil
end

local function copyColor(color)
    return { color[1], color[2], color[3] }
end

local function publicItem(item)
    return {
        id = item.id,
        displayName = item.displayName,
        category = item.category,
        slot = item.slot,
        shape = item.shape,
        price = item.price,
        description = item.description,
        primary = copyColor(item.primary),
        secondary = copyColor(item.secondary),
        originalContent = true,
    }
end

local function validColor(color)
    if type(color) ~= "table" or #color ~= 3 then return false end
    for _, component in ipairs(color) do
        if not isInteger(component) or component < 0 or component > 255 then return false end
    end
    return true
end

local function validateItem(item)
    if type(item) ~= "table"
        or not validIdentifier(item.id, 48)
        or type(item.displayName) ~= "string"
        or item.displayName == ""
        or type(item.description) ~= "string"
        or item.description == ""
        or not isInteger(item.price)
        or item.price < 1
        or item.originalContent ~= true
        or not validColor(item.primary)
        or not validColor(item.secondary) then
        return false
    end
    if item.category ~= "Tops" and item.category ~= "Bottoms" and item.category ~= "Accessories" then
        return false
    end
    if item.slot ~= "top" and item.slot ~= "bottom" and item.slot ~= "accessory" then
        return false
    end
    if item.slot == "accessory"
        and item.shape ~= "backpack"
        and item.shape ~= "glasses"
        and item.shape ~= "headband" then
        return false
    end
    return true
end

local function ownedSet(state)
    local owned = {}
    for _, unlock in ipairs(state.ownership or {}) do
        if unlock.category == OWNERSHIP_CATEGORY then
            owned[unlock.itemId] = true
        end
    end
    return owned
end

function Controller.new(catalog, repositoryProvider)
    assert(type(catalog) == "table", "catalog is required")
    assert(type(repositoryProvider) == "function", "repository provider is required")

    local ordered = {}
    local byId = {}
    for index, item in ipairs(catalog) do
        assert(validateItem(item), "invalid style shop catalog item at index " .. tostring(index))
        assert(byId[item.id] == nil, "duplicate style shop item: " .. item.id)
        ordered[index] = item
        byId[item.id] = item
    end
    assert(#ordered > 0 and #ordered <= 24, "style shop catalog must contain 1-24 items")

    return setmetatable({
        _catalog = ordered,
        _byId = byId,
        _repositoryProvider = repositoryProvider,
    }, Controller)
end

function Controller:_open(playerId)
    if not isInteger(playerId) or playerId <= 0 then
        return nil, "invalid_player"
    end
    local repository, openError = self._repositoryProvider(playerId)
    if repository == nil then
        return nil, "economy_unavailable:" .. tostring(openError or "unknown")
    end
    return repository, nil
end

function Controller:_state(repository)
    local economy = repository:getState()
    local items = {}
    for index, item in ipairs(self._catalog) do
        items[index] = publicItem(item)
    end
    return {
        balance = economy.balance,
        revision = economy.revision,
        owned = ownedSet(economy),
        items = items,
    }
end

function Controller:getState(playerId)
    local repository, openError = self:_open(playerId)
    if repository == nil then
        return { accepted = false, code = openError }
    end
    local state = self:_state(repository)
    state.accepted = true
    state.code = "state_ready"
    return state
end

function Controller:purchase(playerId, itemId, requestId)
    if not validIdentifier(requestId, MAX_REQUEST_ID_LENGTH) then
        return { accepted = false, code = "invalid_request_id" }
    end
    if not validIdentifier(itemId, 48) then
        return { accepted = false, code = "invalid_item" }
    end

    local item = self._byId[itemId]
    if item == nil then
        return { accepted = false, code = "unknown_item" }
    end

    local repository, openError = self:_open(playerId)
    if repository == nil then
        return { accepted = false, code = openError, retryable = true }
    end

    local receipt = repository:record({
        operationId = "style-shop:" .. requestId,
        playerId = playerId,
        delta = -item.price,
        reason = "style-shop:purchase:" .. item.id,
        unlock = {
            category = OWNERSHIP_CATEGORY,
            itemId = item.id,
        },
    })

    if receipt.status == "applied" or receipt.status == "duplicate" then
        local state = self:_state(repository)
        state.accepted = true
        state.code = receipt.status == "applied" and "purchased" or "purchase_already_processed"
        state.itemId = item.id
        state.durable = receipt.durable == true
        return state
    end

    local code = "purchase_failed"
    if receipt.error == "INSUFFICIENT_FUNDS" then
        code = "insufficient_funds"
    elseif receipt.error == "ALREADY_OWNED" then
        code = "already_owned"
    elseif receipt.error == "OPERATION_ID_CONFLICT" then
        code = "request_id_conflict"
    elseif type(receipt.error) == "string" and receipt.error:find("SAVE_", 1, true) then
        code = "persistence_unavailable"
    end

    local state = self:_state(repository)
    state.accepted = code == "already_owned"
    state.code = code
    state.itemId = item.id
    state.retryable = code == "persistence_unavailable"
    return state
end

function Controller:authorizeEquip(playerId, itemId)
    if not validIdentifier(itemId, 48) then
        return { accepted = false, code = "invalid_item" }
    end
    local item = self._byId[itemId]
    if item == nil then
        return { accepted = false, code = "unknown_item" }
    end

    local repository, openError = self:_open(playerId)
    if repository == nil then
        return { accepted = false, code = openError }
    end
    if ownedSet(repository:getState())[itemId] ~= true then
        return { accepted = false, code = "not_owned" }
    end
    return {
        accepted = true,
        code = "equip_authorized",
        item = publicItem(item),
    }
end

Controller.MAX_REQUEST_ID_LENGTH = MAX_REQUEST_ID_LENGTH
Controller.OWNERSHIP_CATEGORY = OWNERSHIP_CATEGORY

return Controller
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="43">
        <Properties>
          <string name="Name">StyleShopService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Runtime Style Shop: durable cash purchases plus original, session-equipped
-- color/geometry wardrobe layers. The client supplies only item/request IDs.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local schoolFoundation = ServerScriptService:WaitForChild("SchoolFoundation")
local EconomyRuntime = require(schoolFoundation:WaitForChild("EconomyRuntime"))
local StyleShopCatalog = require(schoolFoundation:WaitForChild("StyleShopCatalog"))
local StyleShopController = require(schoolFoundation:WaitForChild("StyleShopController"))

local controller = StyleShopController.new(StyleShopCatalog, function(playerId)
    return EconomyRuntime.open(playerId, false)
end)

local remoteRoot = ReplicatedStorage:WaitForChild("SchoolFoundation")
local freeRoam = remoteRoot:FindFirstChild("FreeRoam")
if freeRoam == nil then
    freeRoam = Instance.new("Folder")
    freeRoam.Name = "FreeRoam"
    freeRoam.Parent = remoteRoot
end

local shopRemotes = freeRoam:FindFirstChild("StyleShop")
if shopRemotes == nil then
    shopRemotes = Instance.new("Folder")
    shopRemotes.Name = "StyleShop"
    shopRemotes.Parent = freeRoam
end

local function remoteFunction(name)
    local existing = shopRemotes:FindFirstChild(name)
    if existing then
        assert(existing:IsA("RemoteFunction"), name .. " must be a RemoteFunction")
        return existing
    end
    local remote = Instance.new("RemoteFunction")
    remote.Name = name
    remote.Parent = shopRemotes
    return remote
end

local getState = remoteFunction("GetState")
local purchaseItem = remoteFunction("PurchaseItem")
local equipItem = remoteFunction("EquipItem")

local equippedByPlayer = {}
local characterConnections = {}

local function color3(rgb)
    return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function makePart(folder, name, target, size, relativeCFrame, color, transparency, shape)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = target.CFrame * relativeCFrame
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.Transparency = transparency or 0
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    if shape then part.Shape = shape end
    part.Parent = folder

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = target
    weld.Part1 = part
    weld.Parent = part
    return part
end

local function applyTop(folder, character, item)
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if not torso or not torso:IsA("BasePart") then return end
    local shell = makePart(
        folder,
        "Top_" .. item.id,
        torso,
        torso.Size + Vector3.new(0.1, 0.08, 0.1),
        CFrame.new(),
        color3(item.primary),
        0.08
    )
    makePart(
        folder,
        "TopAccent_" .. item.id,
        shell,
        Vector3.new(math.max(0.5, shell.Size.X * 0.72), 0.16, 0.04),
        CFrame.new(0, shell.Size.Y * 0.18, -shell.Size.Z * 0.51),
        color3(item.secondary),
        0
    )
end

local function applyBottom(folder, character, item)
    local names = {
        { "LeftUpperLeg", "Left Leg" },
        { "RightUpperLeg", "Right Leg" },
    }
    for index, alternatives in ipairs(names) do
        local leg = character:FindFirstChild(alternatives[1]) or character:FindFirstChild(alternatives[2])
        if leg and leg:IsA("BasePart") then
            local shell = makePart(
                folder,
                "Bottom" .. tostring(index) .. "_" .. item.id,
                leg,
                leg.Size + Vector3.new(0.07, 0.06, 0.07),
                CFrame.new(),
                color3(item.primary),
                0.08
            )
            makePart(
                folder,
                "BottomAccent" .. tostring(index) .. "_" .. item.id,
                shell,
                Vector3.new(0.07, math.max(0.35, shell.Size.Y * 0.55), 0.04),
                CFrame.new((index == 1 and -1 or 1) * shell.Size.X * 0.32, 0, -shell.Size.Z * 0.51),
                color3(item.secondary),
                0
            )
        end
    end
end

local function applyAccessory(folder, character, item)
    local primary = color3(item.primary)
    local secondary = color3(item.secondary)
    if item.shape == "backpack" then
        local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        if torso and torso:IsA("BasePart") then
            local pack = makePart(folder, "Daypack", torso, Vector3.new(1.35, 1.5, 0.38), CFrame.new(0, 0, torso.Size.Z * 0.5 + 0.22), primary, 0)
            makePart(folder, "DaypackPocket", pack, Vector3.new(0.9, 0.55, 0.18), CFrame.new(0, -0.28, 0.27), secondary, 0)
        end
    elseif item.shape == "glasses" then
        local head = character:FindFirstChild("Head")
        if head and head:IsA("BasePart") then
            for index, x in ipairs({ -0.36, 0.36 }) do
                makePart(folder, "Lens" .. tostring(index), head, Vector3.new(0.62, 0.5, 0.08), CFrame.new(x, 0.05, -head.Size.Z * 0.5 - 0.06), primary, 0.18)
            end
            makePart(folder, "GlassesBridge", head, Vector3.new(0.22, 0.08, 0.08), CFrame.new(0, 0.05, -head.Size.Z * 0.5 - 0.07), secondary, 0)
        end
    elseif item.shape == "headband" then
        local head = character:FindFirstChild("Head")
        if head and head:IsA("BasePart") then
            makePart(folder, "Headband", head, Vector3.new(head.Size.X + 0.08, 0.2, head.Size.Z + 0.08), CFrame.new(0, head.Size.Y * 0.26, 0), primary, 0.04)
            makePart(folder, "StarlightCharm", head, Vector3.new(0.25, 0.25, 0.12), CFrame.new(head.Size.X * 0.35, head.Size.Y * 0.36, -head.Size.Z * 0.5 - 0.08), secondary, 0, Enum.PartType.Ball)
        end
    end
end

local function applyEquipped(player)
    local character = player.Character
    if character == nil then return end

    local prior = character:FindFirstChild("PipHighStyle")
    if prior then prior:Destroy() end

    local folder = Instance.new("Folder")
    folder.Name = "PipHighStyle"
    folder.Parent = character

    local equipped = equippedByPlayer[player.UserId] or {}
    for _, itemId in pairs(equipped) do
        local authorization = controller:authorizeEquip(player.UserId, itemId)
        if authorization.accepted and authorization.item then
            if authorization.item.slot == "top" then
                applyTop(folder, character, authorization.item)
            elseif authorization.item.slot == "bottom" then
                applyBottom(folder, character, authorization.item)
            elseif authorization.item.slot == "accessory" then
                applyAccessory(folder, character, authorization.item)
            end
        end
    end
end

local function applyWhenCharacterReady(player, character)
    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not humanoid or not humanoid:IsA("Humanoid") then return end
        local torsoName = humanoid.RigType == Enum.HumanoidRigType.R15
            and "UpperTorso"
            or "Torso"
        if not character:WaitForChild(torsoName, 10) then return end
        if not character:WaitForChild("Head", 10) then return end
        if player.Character == character then
            applyEquipped(player)
        end
    end)
end

local function equippedSnapshot(playerId)
    local result = {}
    for slot, itemId in pairs(equippedByPlayer[playerId] or {}) do
        result[slot] = itemId
    end
    return result
end

local function bindPlayer(player)
    if characterConnections[player.UserId] then
        characterConnections[player.UserId]:Disconnect()
    end
    characterConnections[player.UserId] = player.CharacterAdded:Connect(function(character)
        applyWhenCharacterReady(player, character)
    end)
    if player.Character then
        applyWhenCharacterReady(player, player.Character)
    end
end

for _, player in ipairs(Players:GetPlayers()) do bindPlayer(player) end
Players.PlayerAdded:Connect(bindPlayer)
Players.PlayerRemoving:Connect(function(player)
    equippedByPlayer[player.UserId] = nil
    local connection = characterConnections[player.UserId]
    if connection then connection:Disconnect() end
    characterConnections[player.UserId] = nil
end)

getState.OnServerInvoke = function(player)
    local response = controller:getState(player.UserId)
    response.equipped = equippedSnapshot(player.UserId)
    return response
end

purchaseItem.OnServerInvoke = function(player, itemId, requestId)
    local response = controller:purchase(player.UserId, itemId, requestId)
    response.equipped = equippedSnapshot(player.UserId)
    return response
end

equipItem.OnServerInvoke = function(player, itemId)
    local response = controller:authorizeEquip(player.UserId, itemId)
    if response.accepted ~= true or response.item == nil then return response end

    local equipped = equippedByPlayer[player.UserId]
    if equipped == nil then
        equipped = {}
        equippedByPlayer[player.UserId] = equipped
    end
    equipped[response.item.slot] = response.item.id
    player:SetAttribute("StyleShopEquipped_" .. response.item.slot, response.item.id)
    applyEquipped(player)
    return {
        accepted = true,
        code = "equipped",
        itemId = response.item.id,
        equipped = equippedSnapshot(player.UserId),
    }
end

Workspace:SetAttribute("StyleShopCatalogCount", #StyleShopCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">VehicleDynamics</string>
          <string name="Source"><![CDATA[--!strict
-- Pure, deterministic planar vehicle dynamics for the server vehicle adapter.
-- This module deliberately has no Roblox dependencies so its safety and handling
-- rules can be exercised by the command-line spec suite.

local VehicleDynamics = {}

VehicleDynamics.DEFAULTS = {
    maxForwardSpeed = 46,
    maxReverseSpeed = 18,
    forwardAcceleration = 34,
    reverseAcceleration = 22,
    coastResponse = 2.1,
    brakingResponse = 8.5,
    overspeedResponse = 6,
    lateralGrip = 8,
    maximumLongitudinalAcceleration = 64,
    maximumLateralAcceleration = 64,
    turnRate = math.rad(95),
    fullSteerSpeed = 18,
    minimumSteerFactor = 0.22,
    controlDeadzone = 0.01,
    maximumStep = 0.1,
}

local function finiteNumber(value)
    return type(value) == "number"
        and value == value
        and value ~= math.huge
        and value ~= -math.huge
end

local function clamp(value, minimum, maximum)
    if value < minimum then
        return minimum
    end
    if value > maximum then
        return maximum
    end
    return value
end

local function approachZeroAcceleration(speed, response)
    return -speed * response
end

local function wrapAngle(angle)
    return (angle + math.pi) % (2 * math.pi) - math.pi
end

function VehicleDynamics.step(config, state, controls, dt)
    config = config or VehicleDynamics.DEFAULTS
    assert(type(state) == "table", "state is required")
    assert(type(controls) == "table", "controls are required")
    assert(finiteNumber(state.forwardSpeed), "forwardSpeed must be finite")
    assert(finiteNumber(state.lateralSpeed), "lateralSpeed must be finite")
    assert(finiteNumber(state.headingYaw), "headingYaw must be finite")
    assert(finiteNumber(controls.throttle), "throttle must be finite")
    assert(finiteNumber(controls.steer), "steer must be finite")
    assert(finiteNumber(dt) and dt >= 0, "dt must be a non-negative finite number")

    local boundedDt = math.min(dt, config.maximumStep)
    local throttle = clamp(controls.throttle, -1, 1)
    local steer = clamp(controls.steer, -1, 1)
    local forwardSpeed = state.forwardSpeed

    if math.abs(throttle) <= config.controlDeadzone then
        throttle = 0
    end
    if math.abs(steer) <= config.controlDeadzone then
        steer = 0
    end

    local forwardAcceleration
    if throttle > 0 then
        if forwardSpeed >= config.maxForwardSpeed then
            forwardAcceleration = approachZeroAcceleration(
                forwardSpeed - config.maxForwardSpeed,
                config.overspeedResponse
            )
        else
            forwardAcceleration = throttle * config.forwardAcceleration
            if forwardSpeed < 0 then
                forwardAcceleration = forwardAcceleration
                    - forwardSpeed * config.brakingResponse
            end
        end
    elseif throttle < 0 then
        if forwardSpeed <= -config.maxReverseSpeed then
            forwardAcceleration = approachZeroAcceleration(
                forwardSpeed + config.maxReverseSpeed,
                config.overspeedResponse
            )
        else
            forwardAcceleration = throttle * config.reverseAcceleration
            if forwardSpeed > 0 then
                forwardAcceleration = forwardAcceleration
                    - forwardSpeed * config.brakingResponse
            end
        end
    else
        forwardAcceleration = approachZeroAcceleration(forwardSpeed, config.coastResponse)
    end
    forwardAcceleration = clamp(
        forwardAcceleration,
        -config.maximumLongitudinalAcceleration,
        config.maximumLongitudinalAcceleration
    )

    local lateralAcceleration = clamp(
        -state.lateralSpeed * config.lateralGrip,
        -config.maximumLateralAcceleration,
        config.maximumLateralAcceleration
    )

    local steeringSpeed = math.abs(forwardSpeed)
    if math.abs(throttle) > 0 then
        steeringSpeed = math.max(
            steeringSpeed,
            config.fullSteerSpeed * config.minimumSteerFactor
        )
    end
    local steeringAuthority = clamp(
        steeringSpeed / config.fullSteerSpeed,
        0,
        1
    )
    local travelDirection = forwardSpeed < -0.5 and -1 or 1
    local yawRate = -steer
        * config.turnRate
        * steeringAuthority
        * travelDirection
    local headingYaw = wrapAngle(state.headingYaw + yawRate * boundedDt)

    return {
        forwardAcceleration = forwardAcceleration,
        lateralAcceleration = lateralAcceleration,
        yawRate = yawRate,
        headingYaw = headingYaw,
        dt = boundedDt,
    }
end

return VehicleDynamics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">VehicleInput</string>
          <string name="Source"><![CDATA[--!strict
-- Pure validation for owner vehicle controls.
-- Clients may request throttle/steer intent only; the server remains movement authority.

local VehicleInput = {}

local function finiteNumber(value)
    return type(value) == "number"
        and value == value
        and value ~= math.huge
        and value ~= -math.huge
end

local function clampUnit(value)
    if value > 1 then
        return 1
    end
    if value < -1 then
        return -1
    end
    return value
end

function VehicleInput.normalize(throttle, steer)
    if not finiteNumber(throttle) or not finiteNumber(steer) then
        return nil, "invalid_controls"
    end

    return {
        throttle = clampUnit(throttle),
        steer = clampUnit(steer),
    }, nil
end

return VehicleInput
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">VehicleLifecycle</string>
          <string name="Source"><![CDATA[--!strict
-- Pure vehicle lifecycle authority for Pip High Free Roam.
-- Owns one-active-vehicle-per-player state only; Roblox instances/physics live in the server adapter.

local VehicleLifecycle = {}
VehicleLifecycle.__index = VehicleLifecycle

local function validKey(value)
    return type(value) == "string" and value ~= ""
end

local function copy(record)
    if not record then return nil end
    return {
        playerKey = record.playerKey,
        vehicleId = record.vehicleId,
        token = record.token,
    }
end

function VehicleLifecycle.new()
    return setmetatable({
        _active = {},
        _nextToken = 0,
    }, VehicleLifecycle)
end

function VehicleLifecycle:get(playerKey)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    return copy(self._active[playerKey])
end

function VehicleLifecycle:spawn(playerKey, vehicleId)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    assert(validKey(vehicleId), "vehicleId must be a non-empty string")

    local current = self._active[playerKey]
    if current then
        return {
            accepted = false,
            code = "vehicle_already_active",
            state = copy(current),
        }
    end

    self._nextToken = self._nextToken + 1
    local record = {
        playerKey = playerKey,
        vehicleId = vehicleId,
        token = playerKey .. "|" .. tostring(self._nextToken),
    }
    self._active[playerKey] = record

    return {
        accepted = true,
        code = "vehicle_spawn_reserved",
        state = copy(record),
    }
end

function VehicleLifecycle:despawn(playerKey, expectedToken)
    assert(validKey(playerKey), "playerKey must be a non-empty string")
    local current = self._active[playerKey]
    if not current then
        return {
            accepted = true,
            code = "vehicle_already_despawned",
            state = nil,
        }
    end

    if expectedToken ~= nil and expectedToken ~= current.token then
        return {
            accepted = false,
            code = "stale_vehicle_token",
            state = copy(current),
        }
    end

    self._active[playerKey] = nil
    return {
        accepted = true,
        code = "vehicle_despawned",
        state = nil,
        released = copy(current),
    }
end

return VehicleLifecycle
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="47">
        <Properties>
          <string name="Name">VehicleService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Canonical Pip High vehicle adapter.
-- Free Roam owns vehicle lifecycle/controls. Foundation owns world/location state.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local SchoolConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SchoolConfig"))
local schoolFoundation = ServerScriptService:WaitForChild("SchoolFoundation")
local VehicleLifecycle = require(schoolFoundation:WaitForChild("VehicleLifecycle"))
local VehicleInput = require(schoolFoundation:WaitForChild("VehicleInput"))
local VehicleDynamics = require(schoolFoundation:WaitForChild("VehicleDynamics"))

local SPAWN_RADIUS = 72
local CONTROL_TIMEOUT = 0.35
local VEHICLE_ID = "starter-sedan"
local VEHICLE_HANDLING = VehicleDynamics.DEFAULTS

local function getOrCreateFolder(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("Folder"), name .. " must be a Folder")
        return existing
    end
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent
    return folder
end

local function getOrCreateRemoteFunction(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("RemoteFunction"), name .. " must be a RemoteFunction")
        return existing
    end
    local remote = Instance.new("RemoteFunction")
    remote.Name = name
    remote.Parent = parent
    return remote
end

local function getOrCreateRemoteEvent(parent, name)
    local existing = parent:FindFirstChild(name)
    if existing then
        assert(existing:IsA("RemoteEvent"), name .. " must be a RemoteEvent")
        return existing
    end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = parent
    return remote
end

local remoteRoot = ReplicatedStorage:WaitForChild(SchoolConfig.Interfaces.remoteFolder)
local freeRoamRoot = getOrCreateFolder(remoteRoot, "FreeRoam")
local vehicleRoot = getOrCreateFolder(freeRoamRoot, "Vehicles")
local getStateRemote = getOrCreateRemoteFunction(vehicleRoot, "GetState")
local spawnRemote = getOrCreateRemoteFunction(vehicleRoot, "Spawn")
local despawnRemote = getOrCreateRemoteFunction(vehicleRoot, "Despawn")
local controlsRemote = getOrCreateRemoteEvent(vehicleRoot, "SetControls")

local vehicleFolder = getOrCreateFolder(Workspace, "PipHighVehicles")
local lifecycle = VehicleLifecycle.new()
local runtimeByPlayerId = {}

local autoShop = assert(SchoolConfig.WorldLocations.AutoShop, "AutoShop location is required")
local vehicleSpawn = assert(
    SchoolConfig.WorldSpawnSeams and SchoolConfig.WorldSpawnSeams.AutoShopRoad,
    "Foundation AutoShopRoad vehicle spawn seam is required"
)
local spawnPosition = vehicleSpawn.position + Vector3.new(0, 2.2, 0)
local spawnYaw = math.rad(vehicleSpawn.headingDegrees or 0)

local function playerKey(player)
    return tostring(player.UserId)
end

local function characterRoot(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then
        return root
    end
    return nil
end

local function isAtAutoShop(player)
    local root = characterRoot(player)
    return root ~= nil and (root.Position - autoShop.position).Magnitude <= SPAWN_RADIUS
end

local function addPart(model, name, size, cframe, color, className)
    local part = Instance.new(className or "Part")
    part.Name = name
    part.Size = size
    part.CFrame = cframe
    part.Color = color
    part.Anchored = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = model
    return part
end

local function weldAssembly(body, model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            if descendant ~= body then
                local weld = Instance.new("WeldConstraint")
                weld.Name = "BodyWeld"
                weld.Part0 = body
                weld.Part1 = descendant
                weld.Parent = descendant
                descendant.Massless = true
            else
                descendant.Massless = false
            end
            descendant.Anchored = false
        end
    end
end

local function setServerOwnership(body)
    if not body or not body.Parent or body.Anchored then
        return false, "vehicle body is not an active unanchored part"
    end

    -- A seated character can otherwise cause Roblox to hand the assembly to the
    -- driver's client. Keeping ownership on the server makes remote input intent,
    -- validation, timeouts, and the physics actuators the sole movement authority.
    local ok, ownershipError = pcall(function()
        local canSet, reason = body:CanSetNetworkOwnership()
        assert(canSet, reason or "vehicle network ownership is unavailable")
        body:SetNetworkOwner(nil)
    end)
    return ok, ownershipError
end

local function addActuators(body, headingYaw)
    local attachment = Instance.new("Attachment")
    attachment.Name = "DriveAttachment"
    attachment.Parent = body

    local driveForce = Instance.new("VectorForce")
    driveForce.Name = "ServerDriveForce"
    driveForce.Attachment0 = attachment
    driveForce.ApplyAtCenterOfMass = true
    driveForce.RelativeTo = Enum.ActuatorRelativeTo.World
    driveForce.Force = Vector3.zero
    driveForce.Parent = body

    local upright = Instance.new("AlignOrientation")
    upright.Name = "ServerSteering"
    upright.Attachment0 = attachment
    upright.Mode = Enum.OrientationAlignmentMode.OneAttachment
    upright.CFrame = CFrame.Angles(0, headingYaw, 0)
    upright.MaxAngularVelocity = math.rad(160)
    upright.MaxTorque = 200000
    upright.Responsiveness = 18
    upright.RigidityEnabled = false
    upright.Parent = body

    return driveForce, upright
end

local function buildVehicle(player, token)
    local model = Instance.new("Model")
    model.Name = "StarterSedan_" .. tostring(player.UserId)
    model:SetAttribute("OwnerUserId", player.UserId)
    model:SetAttribute("VehicleId", VEHICLE_ID)
    model:SetAttribute("VehicleToken", token)

    local baseCFrame = CFrame.new(spawnPosition) * CFrame.Angles(0, spawnYaw, 0)
    local body = addPart(
        model,
        "Body",
        Vector3.new(7.5, 1.6, 11),
        baseCFrame,
        Color3.fromRGB(67, 111, 168)
    )
    body.CanCollide = true
    body.CustomPhysicalProperties = PhysicalProperties.new(1.2, 0.35, 0.15, 1, 1)

    local hood = addPart(
        model,
        "Hood",
        Vector3.new(7, 1.1, 3.4),
        baseCFrame * CFrame.new(0, 1.1, -3.1),
        Color3.fromRGB(79, 128, 190)
    )
    hood.CanCollide = false

    local cabin = addPart(
        model,
        "Cabin",
        Vector3.new(6.2, 2.3, 4.6),
        baseCFrame * CFrame.new(0, 1.65, 0.65),
        Color3.fromRGB(148, 190, 214)
    )
    cabin.Material = Enum.Material.Glass
    cabin.Transparency = 0.28
    cabin.CanCollide = false

    local seat = addPart(
        model,
        "DriverSeat",
        Vector3.new(2.6, 1, 2.8),
        baseCFrame * CFrame.new(0, 1.4, 1),
        Color3.fromRGB(45, 49, 58),
        "VehicleSeat"
    )
    seat.CanCollide = true
    seat.MaxSpeed = VEHICLE_HANDLING.maxForwardSpeed
    seat.Torque = 0
    seat.TurnSpeed = 0
    seat.HeadsUpDisplay = false

    for wheelIndex, wheelSpec in ipairs({
        { -3.6, -1.0, -3.2 },
        { 3.6, -1.0, -3.2 },
        { -3.6, -1.0, 3.2 },
        { 3.6, -1.0, 3.2 },
    }) do
        local wheel = addPart(
            model,
            "Wheel" .. tostring(wheelIndex),
            Vector3.new(1.2, 2.5, 2.5),
            baseCFrame * CFrame.new(wheelSpec[1], wheelSpec[2], wheelSpec[3]),
            Color3.fromRGB(32, 34, 40)
        )
        wheel.Shape = Enum.PartType.Cylinder
        wheel.CanCollide = true
        -- The force-based arcade chassis supplies its own lateral grip. Low tire
        -- friction lets the welded primitive wheels travel with the body
        -- without static friction overpowering the bounded drive acceleration.
        wheel.CustomPhysicalProperties = PhysicalProperties.new(0.8, 0.08, 0.1, 1, 1)
    end

    for lightIndex, lightSpec in ipairs({
        { x = -2.35, y = 0.45, z = -5.55, color = Color3.fromRGB(255, 239, 178), name = "Headlight" },
        { x = 2.35, y = 0.45, z = -5.55, color = Color3.fromRGB(255, 239, 178), name = "Headlight" },
        { x = -2.35, y = 0.35, z = 5.55, color = Color3.fromRGB(207, 57, 62), name = "TailLight" },
        { x = 2.35, y = 0.35, z = 5.55, color = Color3.fromRGB(207, 57, 62), name = "TailLight" },
    }) do
        local light = addPart(
            model,
            lightSpec.name .. tostring(lightIndex),
            Vector3.new(1.35, 0.6, 0.24),
            baseCFrame * CFrame.new(lightSpec.x, lightSpec.y, lightSpec.z),
            lightSpec.color
        )
        light.Material = Enum.Material.Neon
        light.CanCollide = false
    end

    for bumperIndex, zOffset in ipairs({ -5.72, 5.72 }) do
        local bumper = addPart(
            model,
            "Bumper" .. tostring(bumperIndex),
            Vector3.new(7.2, 0.42, 0.34),
            baseCFrame * CFrame.new(0, -0.38, zOffset),
            Color3.fromRGB(47, 53, 63)
        )
        bumper.Material = Enum.Material.Metal
        bumper.CanCollide = false
    end

    model.PrimaryPart = body
    model.Parent = vehicleFolder
    local driveForce, upright = addActuators(body, spawnYaw)
    weldAssembly(body, model)
    local ownsServer, ownershipError = setServerOwnership(body)
    if not ownsServer then
        model:Destroy()
        error("vehicle_server_ownership_failed: " .. tostring(ownershipError))
    end

    return model, seat, body, driveForce, upright
end

local function ejectSeat(seat)
    local humanoid = seat and seat.Occupant
    if humanoid then
        humanoid.Sit = false
    end
end

local function destroyRuntime(playerId)
    local runtime = runtimeByPlayerId[playerId]
    if not runtime then
        return
    end

    ejectSeat(runtime.seat)
    if runtime.driveForce then
        runtime.driveForce.Force = Vector3.zero
    end
    if runtime.model and runtime.model.Parent then
        runtime.model:Destroy()
    end
    runtimeByPlayerId[playerId] = nil
end

local function isOwnerSeated(player, runtime)
    if not runtime or not runtime.seat then
        return false
    end
    local occupant = runtime.seat.Occupant
    return occupant ~= nil
        and Players:GetPlayerFromCharacter(occupant.Parent) == player
end

local function clearControls(runtime)
    if not runtime then
        return
    end
    runtime.throttle = 0
    runtime.steer = 0
    runtime.lastControlAt = 0
end

local function publicState(player)
    local state = lifecycle:get(playerKey(player))
    local runtime = runtimeByPlayerId[player.UserId]
    return {
        active = state ~= nil,
        vehicleId = state and state.vehicleId or nil,
        token = state and state.token or nil,
        atAutoShop = isAtAutoShop(player),
        autoShopDisplayName = autoShop.displayName,
        driving = isOwnerSeated(player, runtime),
    }
end

spawnRemote.OnServerInvoke = function(player)
    if not isAtAutoShop(player) then
        return {
            accepted = false,
            code = "not_at_auto_shop",
            state = publicState(player),
        }
    end

    local reservation = lifecycle:spawn(playerKey(player), VEHICLE_ID)
    if not reservation.accepted then
        return {
            accepted = false,
            code = reservation.code,
            state = publicState(player),
        }
    end

    local ok, modelOrError, seat, body, driveForce, upright = pcall(function()
        return buildVehicle(player, reservation.state.token)
    end)
    if not ok then
        lifecycle:despawn(playerKey(player), reservation.state.token)
        return {
            accepted = false,
            code = "vehicle_spawn_failed",
            error = tostring(modelOrError),
            state = publicState(player),
        }
    end

    local model = modelOrError
    runtimeByPlayerId[player.UserId] = {
        model = model,
        seat = seat,
        body = body,
        driveForce = driveForce,
        upright = upright,
        token = reservation.state.token,
        headingYaw = spawnYaw,
        throttle = 0,
        steer = 0,
        lastControlAt = 0,
    }

    seat:GetPropertyChangedSignal("Occupant"):Connect(function()
        local runtime = runtimeByPlayerId[player.UserId]
        local occupant = seat.Occupant
        if not occupant then
            clearControls(runtime)
            setServerOwnership(body)
            return
        end
        local occupantPlayer = Players:GetPlayerFromCharacter(occupant.Parent)
        if occupantPlayer ~= player then
            clearControls(runtime)
            occupant.Sit = false
            return
        end
        setServerOwnership(body)
    end)

    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        seat:Sit(humanoid)
    end

    return {
        accepted = true,
        code = "vehicle_spawned",
        state = publicState(player),
    }
end

despawnRemote.OnServerInvoke = function(player)
    local current = lifecycle:get(playerKey(player))
    local result = lifecycle:despawn(
        playerKey(player),
        current and current.token or nil
    )
    if result.accepted then
        destroyRuntime(player.UserId)
    end
    return {
        accepted = result.accepted,
        code = result.code,
        state = publicState(player),
    }
end

getStateRemote.OnServerInvoke = function(player)
    return publicState(player)
end

controlsRemote.OnServerEvent:Connect(function(player, throttle, steer)
    local runtime = runtimeByPlayerId[player.UserId]
    if not runtime or not isOwnerSeated(player, runtime) then
        clearControls(runtime)
        return
    end

    local active = lifecycle:get(playerKey(player))
    if not active or active.token ~= runtime.token then
        clearControls(runtime)
        return
    end

    local controls = VehicleInput.normalize(throttle, steer)
    if not controls then
        clearControls(runtime)
        return
    end

    runtime.throttle = controls.throttle
    runtime.steer = controls.steer
    runtime.lastControlAt = os.clock()
end)

Players.PlayerRemoving:Connect(function(player)
    local current = lifecycle:get(playerKey(player))
    lifecycle:despawn(playerKey(player), current and current.token or nil)
    destroyRuntime(player.UserId)
end)

RunService.Heartbeat:Connect(function(dt)
    for playerId, runtime in pairs(runtimeByPlayerId) do
        if not runtime.model or not runtime.model.Parent then
            lifecycle:despawn(tostring(playerId), runtime.token)
            runtimeByPlayerId[playerId] = nil
            continue
        end

        local seat = runtime.seat
        local occupant = seat and seat.Occupant
        local owner = Players:GetPlayerByUserId(playerId)
        local ownerIsDriving = false
        if owner and occupant then
            local occupantPlayer = Players:GetPlayerFromCharacter(occupant.Parent)
            if occupantPlayer == owner then
                ownerIsDriving = true
            else
                occupant.Sit = false
            end
        end

        local throttle = runtime.throttle or 0
        local steer = runtime.steer or 0
        if not ownerIsDriving
            or runtime.lastControlAt == 0
            or os.clock() - runtime.lastControlAt > CONTROL_TIMEOUT then
            throttle = 0
            steer = 0
            runtime.throttle = 0
            runtime.steer = 0
        end

        local body = runtime.body
        if not body or not body.Parent then
            lifecycle:despawn(tostring(playerId), runtime.token)
            destroyRuntime(playerId)
            continue
        end

        local orientation = CFrame.Angles(0, runtime.headingYaw, 0)
        local heading = orientation.LookVector
        local right = orientation.RightVector
        local velocity = body.AssemblyLinearVelocity
        local step = VehicleDynamics.step(VEHICLE_HANDLING, {
            forwardSpeed = velocity:Dot(heading),
            lateralSpeed = velocity:Dot(right),
            headingYaw = runtime.headingYaw,
        }, {
            throttle = throttle,
            steer = steer,
        }, dt)

        runtime.headingYaw = step.headingYaw
        local assemblyMass = body.AssemblyMass
        local planarForce = (
            heading * step.forwardAcceleration
            + right * step.lateralAcceleration
        ) * assemblyMass
        runtime.driveForce.Force = Vector3.new(planarForce.X, 0, planarForce.Z)
        runtime.upright.CFrame = CFrame.Angles(0, runtime.headingYaw, 0)
    end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
