				<Item class="Script" referent="RBXb4d1fc873b224b7e8250eb0941d8e89b">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Pathfinding</string>
						<string name="ScriptGuid">{560A0721-3FC4-4FF7-B831-7D3DE2CE6A6C}</string>
						<ProtectedString name="Source"><![CDATA[

--
local PathfindingService = game:GetService("PathfindingService")
local humanoid = script.Parent.Parent:WaitForChild("Humanoid")

targetV = script.Parent:WaitForChild("Target")

local WanderX, WanderZ = 100, 100


local hroot = script.Parent.Parent:WaitForChild("HumanoidRootPart")
local origPos= hroot.Position


function getRandomPoint()

	
	local desgx, desgz = origPos.x + math.random(-WanderX,WanderX), origPos.z + math.random(-WanderZ,WanderZ)


	local point= Vector3.new(desgx, origPos.y, desgz)
	
	
	warn('New point:', point)
	return point
end



local currentWaypointIndex=0
local waypoints

warn('Calc spider path')
local path = PathfindingService:CreatePath()

local destinationPos

local function followPath(destinationPos)
	-- Compute and check the path
	path:ComputeAsync(hroot.Position, destinationPos)
	-- Empty waypoints table after each new path computation
	waypoints = {}

	if path.Status == Enum.PathStatus.Success then
		-- Get the path waypoints and start zombie walking
		waypoints = path:GetWaypoints()
		for _, waypoint in pairs(waypoints) do
			local part = Instance.new("Part")
			part.Shape = "Ball"
			part.Material = "Neon"
			part.Size = Vector3.new(0.6, 0.6, 0.6)
			part.Position = waypoint.Position
			part.Anchored = true
			part.CanCollide = false
			part.Parent = game.Workspace
		end
		-- Move to first waypoint
		currentWaypointIndex = 1
		humanoid:MoveTo(waypoints[currentWaypointIndex].Position)
	else
		-- Error (path not found); stop humanoid
		warn('Path not found')
		destinationPos = getRandomPoint()
		followPath(destinationPos)
	end
end

local function onWaypointReached(reached)
	
	
	if reached and currentWaypointIndex < #waypoints then
		currentWaypointIndex = currentWaypointIndex + 1
		humanoid:MoveTo(waypoints[currentWaypointIndex].Position)
	elseif reached and currentWaypointIndex == #waypoints then
		destinationPos = getRandomPoint()
		warn('New random point')
		followPath(destinationPos)
	
	end
	
end


-----------------

if  humanoid.Torso then
	
	destinationPos = getRandomPoint()
	
	local function onPathBlocked(blockedWaypointIndex)
		-- Check if the obstacle is further down the path
		if blockedWaypointIndex > currentWaypointIndex then
			-- Call function to re-compute the path
			followPath(destinationPos)
		end
	end




	-- Connect 'Blocked' event to the 'onPathBlocked' function
	path.Blocked:Connect(onPathBlocked)

	-- Connect 'MoveToFinished' event to the 'onWaypointReached' function
	humanoid.MoveToFinished:Connect(onWaypointReached)
	

	followPath(destinationPos)
end
]]></ProtectedString>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
				<Item class="BindableEvent" referent="RBX29be6d8306fc42808ceeb7060325f616">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<string name="Name">MouseDown</string>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBXe2738b84fca24c2e8c7548c41595ffea">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">AutoJump</string>
						<string name="ScriptGuid">{51D40E8C-3836-4A89-82E3-7FD5C8CBBE2A}</string>
						<ProtectedString name="Source"><![CDATA[local h = script.Parent.Parent:WaitForChild("Humanoid")

while wait(math.random()/4) do
	if h.Torso then
		local check1 = game.Workspace:FindPartOnRay(Ray.new(h.Torso.Position-Vector3.new(0,1.5,0), h.Torso.CFrame.lookVector*3), h.Parent)
		local check2 = game.Workspace:FindPartOnRay(Ray.new(h.Torso.Position+Vector3.new(0,1.5,0), h.Torso.CFrame.lookVector*3), h.Parent)
		

		if check1 or check2 then

			h.Jump = true

		end
		
	end
end]]></ProtectedString>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
				<Item class="ObjectValue" referent="RBXa3b8e58755794f52a70b32d72cbee3fc">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<string name="Name">Target</string>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
