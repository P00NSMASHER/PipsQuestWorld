{
  "name": "PipHigh",
  "servePort": 8005,
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 256,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Brightness": 2,
        "ClockTime": 10.5,
        "GlobalShadows": true,
        "Technology": "ShadowMap",
        "Ambient": [0.55, 0.55, 0.55],
        "OutdoorAmbient": [0.6, 0.6, 0.6]
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$className": "Folder",
        "SchoolConfig": {
          "$path": "src/shared/SchoolConfig.lua"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "SchoolFoundation": {
        "$className": "Folder",
        "CampusBuilder": {
          "$path": "src/server/CampusBuilder.server.lua"
        },
        "FoundationBootstrap": {
          "$path": "src/server/FoundationBootstrap.server.lua"
        },
        "EducationEngine": {
          "$path": "src/server/EducationEngine.lua"
        },
        "ClassSessionController": {
          "$path": "src/server/ClassSessionController.lua"
        },
        "ClassActivityCatalog": {
          "$path": "src/server/ClassActivityCatalog.lua"
        },
        "ClassEducation": {
          "$path": "src/server/ClassEducation.server.lua"
        }
      }
    }
  }
}
